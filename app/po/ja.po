msgctxt "dev_verdicts_held_desktop"
msgid "Verdicts held"
msgstr "保留された判定"

#. Developer page: the explanation under the 'Verdicts held' measurement (desktop wording).
msgctxt "dev_verdicts_held_desktop_detail"
msgid "Convictions withheld because this machine's own uplink, not the provider, was silent (uplink / transport)"
msgstr "プロバイダーではなくこのコンピューター自身のアップリンクが無通信だったため保留された判定（アップリンク / トランスポート）"

#. Developer tools screen: explanatory subtext under the 'verdicts held' control.
msgctxt "dev_verdicts_held_detail"
msgid "Convictions withheld because the phone's own uplink, not the provider, was silent (uplink / transport)"
msgstr "プロバイダーではなく端末自身のアップリンクが無通信だったため保留された判定（アップリンク / トランスポート）"

#. Developer tools screen: formatted value readout for 'verdicts held'.
msgctxt "dev_verdicts_held_value"
msgid "{0} / {1}"
msgstr "{0} / {1}"

#. Developer tools screen (reliability surface): worst loss control label.
msgctxt "dev_worst_loss"
msgid "Worst single failure"
msgstr "最悪の単一障害"

#. Developer tools screen: explanatory subtext under the 'worst loss' control.
msgctxt "dev_worst_loss_detail"
