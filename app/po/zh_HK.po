#. Call to action
msgctxt "add_blocked_location"
msgid "Add blocked location"
msgstr "添加被屏蔽的位置"

#. Points leaderboard: button that opens the emoji tag editor when no tag is set yet.
msgctxt "add_emoji"
msgid "Add emoji"
msgstr "新增表情"

#. Call to action on a split-rule activity row blocked by URnetwork safety rules: create a local split rule for its hosts.
msgctxt "add_local_split_rule"
msgid "Route locally"
