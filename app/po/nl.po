msgid "Show file"
msgstr "Bestand tonen"

#. Update notice progress line (Linux Settings, Windows update banner) while the release downloads.
msgctxt "upd_stage_downloading"
msgid "Downloading the update…"
msgstr "Update downloaden…"

#. Windows update banner progress line while the verified installer is being launched.
msgctxt "upd_stage_installing"
msgid "Starting the installer…"
msgstr "Installatieprogramma starten…"

#. Linux Settings update notice progress line while the verified download replaces the running AppImage file.
msgctxt "upd_stage_replacing"
msgid "Replacing the AppImage…"
msgstr "AppImage vervangen…"

#. Update progress line (Linux Settings, Windows update banner, macOS Settings > Software update) while the downloaded release is checked against its published checksum.
msgctxt "upd_stage_verifying"
msgid "Verifying the download…"
msgstr "Download controleren…"

