msgstr "whodis pump"

#. One line description of the whodis pump (DNS pump) transport in the transport settings editor.
msgctxt "transport_dnspump_description"
msgid "Disguised as DNS traffic with a constant reply pump. Lowest bandwidth, highest availability."
msgstr "Disfarçado de tráfego DNS com uma bomba constante de respostas. Menor largura de banda, maior disponibilidade."

#. Transport name: HTTP/1.1 over TLS. A protocol name; never translated.
msgctxt "transport_h1"
msgid "H1"
msgstr "H1"

#. One line description of the H1 transport in the transport settings editor.
msgctxt "transport_h1_description"
msgid "Direct over TLS. Works on most networks."
msgstr "Direto sobre TLS. Funciona na maioria das redes."

#. Transport name: HTTP/3 over QUIC. A protocol name; never translated.
msgctxt "transport_h3"
msgid "H3"
msgstr "H3"

#. One line description of the H3 transport in the transport settings editor.
msgctxt "transport_h3_description"
msgid "Direct over QUIC. Fastest where it is not filtered."
msgstr "Direto sobre QUIC. O mais rápido onde não é filtrado."

#. Transport name: peer to peer. A protocol name; never translated.
