msgstr "Blocs"

#. Snackbar shown after copying the bonus referral code. Used in Shared/Views/Introduction/ParticipateReferView.swift, Main/Account/Settings/SettingsForm-iOS.swift and Main/Account/Settings/SettingsForm-macOS.swift.
msgctxt "bonus_referral_code_copied_to_clipboard"
msgid "Bonus referral code copied to clipboard"
msgstr "Code de parrainage bonus copié dans le presse-papiers"

#. Call to action
msgctxt "bonus_referral_code_label"
msgid "Bonus referral code"
msgstr "Code de parrainage bonus"

#. A description of how users can earn more data by referring friends.
msgctxt "boost_bandwidth_details"
msgid "You get free data every month, and can earn more by referring friends."
msgstr "En participant au réseau et en fournissant de la bande passante, vous pouvez gagner des récompenses."

#. A title for the introductory usage bar.
msgctxt "boost_your_bandwidth"
msgid "Boost Your Bandwidth"
msgstr "Boostez votre bande passante"

#. Call to action
msgctxt "browse_locations"
