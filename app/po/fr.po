#. Badge text for the head mining spot.
msgctxt "top200"
msgid "Top 200"
msgstr "Top 200"

#. Detail under the bound status.
msgctxt "top200_bound_detail"
msgid "Emission is paid to your coldkey directly. Bindings renew per epoch."
msgstr "L’émission est versée directement sur votre coldkey. Les liaisons se renouvellent à chaque époque."

#. Status row once bound.
msgctxt "top200_bound_status"
msgid "UID {0} · rank #{1}"
msgstr "UID {0} · rang #{1}"

#. Warning when the score nears the floor.
msgctxt "top200_demotion_warning"
msgid "Your score is close to the eviction floor. Add routable IPs to keep the spot."
msgstr "Votre score est proche du seuil d’éviction. Ajoutez des IP routables pour garder la place."

#. Detail of the Top 200 tile when eligible.
msgctxt "top200_detail"
msgid "Your network's routable IP breadth ranks about #{0} of {1} head spots. Head miners earn SN25α natively, every tempo."
msgstr "La diversité d’IP routables de votre réseau se classe environ #{0} sur {1} places de tête. Les mineurs de tête gagnent des SN25α nativement, à chaque tempo."

#. Top 200 sign screen: the button that signs the reviewed binding with this device's client key (local only).
msgctxt "top200_sign_action"
msgid "Sign with this device"
msgstr "Signer avec cet appareil"

#. Top 200: the button that opens the screen where this device signs its fleet binding, and that screen's title. The ur.io Top 200 page names it in its steps (Earnings › Top 200 › Sign fleet binding).
msgctxt "top200_sign_binding"
msgid "Sign fleet binding"
msgstr "Signer la liaison de flotte"

#. Top 200 sign screen: label of the field where the binding JSON from the ur.io Top 200 page is pasted.
msgctxt "top200_sign_binding_label"
msgid "Binding to sign"
msgstr "Liaison à signer"

#. Top 200 sign screen: the binding's EVM chain id and Bittensor subnet (netuid).
msgctxt "top200_sign_chain"
msgid "Chain {0} · subnet {1}"
msgstr "Chaîne {0} · sous-réseau {1}"

#. Top 200 sign screen: label of this device's Ed25519 client public key (0x hex).
msgctxt "top200_sign_client_key"
msgid "Client key"
msgstr "Clé client"

#. Top 200 sign screen: button that copies this device's fleet manifest member entry {"client_id":"0x…","client_key":"0x…"}.
msgctxt "top200_sign_copy_member"
msgid "Copy member entry"
msgstr "Copier l’entrée de membre"

#. Top 200 sign screen: button that copies the signed {binding, client_signature} payload.
msgctxt "top200_sign_copy_payload"
msgid "Copy payload"
msgstr "Copier les données"

#. Top 200 sign screen: shown with the signed {binding, client_signature} payload. 'Device signature' is the ur.io page's field label (site_app_top200_device_signature).
msgctxt "top200_sign_done"
msgid "Signed. Copy the payload and paste it on the Top 200 page under Device signature."
msgstr "Signée. Copiez les données et collez-les sur la page Top 200, sous Signature de l’appareil."

#. Top 200 sign screen: the binding's validity window (valid_from_epoch, valid_to_epoch), both inclusive.
msgctxt "top200_sign_epochs"
msgid "Valid from epoch {0} to {1}"
msgstr "Valide de l’époque {0} à {1}"

#. Top 200 sign screen: SignSnFleetBinding returned an error; {detail} is the SDK's error text.
msgctxt "top200_sign_error_failed"
msgid "The binding could not be signed: {}"
msgstr "Impossible de signer la liaison : {}"

#. Top 200 sign screen: the pasted text is not a fleet binding JSON (or the app link's binding did not decode).
msgctxt "top200_sign_error_invalid"
msgid "This is not a fleet binding. Copy the whole binding from the Top 200 page."
msgstr "Ce n’est pas une liaison de flotte. Copiez la liaison entière depuis la page Top 200."

#. Top 200 sign screen: GetSnClientKey returned nothing (no client key, or the desktop/extension service that holds it is not running).
msgctxt "top200_sign_error_no_key"
msgid "This device's client key is not available right now. Start URnetwork on this device, then try again."
msgstr "La clé client de cet appareil n’est pas disponible pour le moment. Démarrez URnetwork sur cet appareil, puis réessayez."

#. Top 200 sign screen: the binding's client_id or client_key is not this device's; the app refuses to sign it.
msgctxt "top200_sign_error_other_device"
msgid "This binding is for another device. A device signs only the binding with its own client ID and client key."
msgstr "Cette liaison concerne un autre appareil. Un appareil ne signe que la liaison portant son propre ID client et sa propre clé client."

#. Top 200 sign screen: label of the binding's fleet_id (0x hex).
msgctxt "top200_sign_fleet_id"
msgid "Fleet ID"
msgstr "ID de flotte"

#. Top 200 sign screen: label of the binding's hotkey (0x hex public key). Hotkey is the Bittensor term.
msgctxt "top200_sign_hotkey"
msgid "Hotkey"
msgstr "Hotkey"

#. Top 200 sign screen: intro. The binding is built on the ur.io Top 200 page; the app signs it locally and sends nothing.
msgctxt "top200_sign_intro"
msgid "Your fleet operator builds this device's binding on the Top 200 page at ur.io. Paste it here to sign it with this device's client key. Nothing is sent: you copy the signed payload back to the page yourself."
msgstr "L’opérateur de votre flotte prépare la liaison de cet appareil sur la page Top 200 de ur.io. Collez-la ici pour la signer avec la clé client de cet appareil. Rien n’est envoyé : vous recopiez vous-même les données signées sur la page."

#. Top 200 sign screen: why the operator needs this device's member entry (client ID and client key) for the fleet manifest.
msgctxt "top200_sign_member_hint"
msgid "Your fleet manifest lists this device by its client ID and client key. Copy its member entry and send it to your fleet operator."
msgstr "Le manifeste de votre flotte identifie cet appareil par son ID client et sa clé client. Copiez son entrée de membre et envoyez-la à l’opérateur de votre flotte."

#. Top 200 sign screen: button that pastes the binding from the clipboard.
msgctxt "top200_sign_paste"
msgid "Paste"
msgstr "Coller"

#. Top 200 sign screen: shown above the parsed binding's values before the Sign button.
msgctxt "top200_sign_review"
msgid "Check that the fleet ID, hotkey and epochs match the Top 200 page before you sign."
msgstr "Avant de signer, vérifiez que l’ID de flotte, la hotkey et les époques correspondent à la page Top 200."

#. Top 200 sign screen: label of the section showing this device's client ID and client key.
msgctxt "top200_sign_this_device"
msgid "This device"
msgstr "Cet appareil"

#. Headline of the Top 200 tile when eligible.
msgctxt "top200_you_qualify"
msgid "You qualify"
msgstr "Vous êtes éligible"

