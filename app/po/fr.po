msgctxt "all_the_content_in_the_world_from_urnetwork"
msgid "All the content in the world from URnetwork"
msgstr "Tout le contenu du monde par URnetwork"

#. Settings
msgctxt "allow_local_connections"
msgid "Allow local connections"
msgstr "Autoriser les connexions locales"

#. Call to action
msgctxt "allow_provider_cell_network_unlimited_plan"
msgid "You can also allow the provider to use cell network data, which works great if you have an unlimited plan."
msgstr "Vous pouvez également autoriser le fournisseur à utiliser les données du réseau cellulaire, ce qui fonctionne très bien si vous avez un forfait illimité."

#. Call to action
msgctxt "allow_providing_cell"
msgid "Allow providing on cellular network"
msgstr "Autoriser la fourniture sur le réseau cellulaire"

#. Text for a chip that indicates that the action is allowed.
msgctxt "allowed"
msgid "Allowed"
