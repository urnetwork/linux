msgctxt "contract_stack_max"
msgid "max {}"
msgstr "maks {}"

#. A description of the contract details view.
msgctxt "contracts_appear_connected"
msgid "Contracts appear here while connected."
msgstr "Kontrakty pojawią się tutaj po połączeniu."

#. A description of the contract details view.
msgctxt "contracts_appear_providing"
msgid "Contracts appear here while providing."
msgstr "Kontrakty pojawią się tutaj podczas udostępniania."

#. Onboarding: title of the step that asks whether this device may share bandwidth with the network (provide).
msgctxt "contribute_bandwidth"
msgid "Contribute bandwidth"
msgstr "Udostępnij przepustowość"

#. Bootstrap DNS-over-HTTPS server error: the URL does not start with https://. https:// is literal and is not translated.
msgctxt "control_doh_error_https_required"
msgid "The URL must start with https://."
msgstr "Adres URL musi zaczynać się od https://."

#. Bootstrap DNS-over-HTTPS server error: the URL names a host name where an IP address is needed. The example URL is literal and is not translated.
msgctxt "control_doh_error_ip_required"
msgid "Use an IP address, not a host name, such as https://223.5.5.5/dns-query."
msgstr "Użyj adresu IP zamiast nazwy hosta, np. https://223.5.5.5/dns-query."

#. Bootstrap DNS-over-HTTPS server error: the list has more servers of one IP version than the app accepts.
msgctxt "control_doh_error_too_many"
msgid "Too many servers. Remove some and save again."
msgstr "Za dużo serwerów. Usuń niektóre i zapisz ponownie."

#. Bootstrap DNS-over-HTTPS server error: the line is not a complete URL the app can query (no path, a query or fragment, user info or a bad port). The example URL is literal and is not translated.
msgctxt "control_doh_error_url_invalid"
msgid "Enter a full URL, such as https://223.5.5.5/dns-query."
msgstr "Wpisz pełny adres URL, np. https://223.5.5.5/dns-query."

#. Extender settings: the title of the list of bootstrap DNS-over-HTTPS servers a user can add for the lookups of URnetwork's own server names. DNS-over-HTTPS is a protocol name and is not translated.
msgctxt "control_doh_urls"
msgid "Bootstrap DNS-over-HTTPS servers"
msgstr "Serwery startowe DNS-over-HTTPS"

#. Extender settings: explains the bootstrap DNS-over-HTTPS server list. It must say that URnetwork looks up its own server names through the added servers first, and that those servers can see these lookups.
msgctxt "control_doh_urls_description"
msgid "URnetwork looks up the names of its own servers over DNS-over-HTTPS. If the built-in servers are blocked on your network, add servers that work there. URnetwork tries them first, and they can see these lookups."
msgstr "URnetwork wyszukuje nazwy własnych serwerów przez DNS-over-HTTPS. Jeśli wbudowane serwery są zablokowane w Twojej sieci, dodaj serwery, które w niej działają. URnetwork używa ich w pierwszej kolejności, a one widzą te zapytania."

#. Extender settings: help text under the bootstrap DNS-over-HTTPS server list. https:// and the example URL are literal and are not translated.
msgctxt "control_doh_urls_hint"
msgid "One URL per line, starting with https:// and an IP address, such as https://223.5.5.5/dns-query."
msgstr "Jeden adres URL w wierszu, zaczynający się od https:// i adresu IP, np. https://223.5.5.5/dns-query."

#. Bootstrap DNS-over-HTTPS servers: note after saving where the VPN runs separately from the app (the iOS tunnel extension, the desktop service). It reads the servers at its next start.
msgctxt "control_doh_urls_next_connect"
msgid "The VPN uses the new bootstrap servers the next time it connects."
msgstr "VPN użyje nowych serwerów startowych przy następnym połączeniu."

#. Extender settings: button that clears the bootstrap DNS-over-HTTPS server list, so only the built-in servers are used.
msgctxt "control_doh_urls_reset"
msgid "Use built-in servers only"
msgstr "Używaj tylko wbudowanych serwerów"

#. Confirmation after the bootstrap DNS-over-HTTPS servers are saved.
msgctxt "control_doh_urls_saved"
msgid "Bootstrap DNS-over-HTTPS servers saved"
msgstr "Zapisano serwery startowe DNS-over-HTTPS"

#. Extender settings: button that fills the bootstrap DNS-over-HTTPS server list with resolvers that are reachable in mainland China.
msgctxt "control_doh_use_china"
msgid "Use China resolvers"
msgstr "Użyj chińskich serwerów DNS"

#. Extender settings: note under the Use China resolvers button naming the operators it fills in. AliDNS and DNSPod are product names and are not translated.
msgctxt "control_doh_use_china_hint"
msgid "Fills in the AliDNS and DNSPod servers, which are reachable in mainland China."
msgstr "Wpisuje serwery AliDNS i DNSPod, które są dostępne w Chinach kontynentalnych."

