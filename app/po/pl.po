msgctxt "adv_exit_flows_total"
msgid "Exit flows"
msgstr "Przepływy wyjściowe"

#. Connection inspector: exit state, OK.
msgctxt "adv_exit_ok"
msgid "OK"
msgstr "OK"

#. Connection inspector: exit state, proven.
msgctxt "adv_exit_proven"
msgid "Proven"
msgstr "Sprawdzony"

#. Connection inspector: exit state, quarantined.
msgctxt "adv_exit_quarantined"
msgid "Quarantined"
msgstr "W kwarantannie"

#. Connection inspector: label of the exit state row.
msgctxt "adv_exit_state"
msgid "Exit state"
msgstr "Stan wyjścia"

#. Connection inspector: label of the exit tier row.
msgctxt "adv_exit_tier"
msgid "Exit tier"
msgstr "Poziom wyjścia"

#. Connection inspector: exit state, warning.
msgctxt "adv_exit_warning"
msgid "Warning"
msgstr "Ostrzeżenie"

#. Connection inspector: label of the warning cause row.
msgctxt "adv_exit_warning_cause"
msgid "Warning cause"
msgstr "Przyczyna ostrzeżenia"

#. Connection inspector: heading of the exits section.
msgctxt "adv_exits"
msgid "Exits"
msgstr "Wyjścia"

#. Connect page, Activity pane: the first choice of the verdict filter above the list of connections (routing decisions). Shows every connection, whatever its verdict. Short: it shares one row with Blocked, Tunnelled and Bypassed.
msgctxt "adv_filter_all"
msgid "All"
msgstr "Wszystkie"

#. Connect page, Activity pane: the verdict filter choice that shows only the connections that bypassed the tunnel (allowed, but sent directly from this device outside the VPN, for example by a split rule, so not protected). Short: it shares one row with All, Blocked and Tunnelled.
msgctxt "adv_filter_bypassed"
msgid "Bypassed"
msgstr "Poza tunelem"

#. Connect page, Activity pane: the verdict filter choice that shows only the connections sent through the URnetwork tunnel (allowed and protected). Short: it shares one row with All, Blocked and Bypassed.
msgctxt "adv_filter_tunnelled"
msgid "Tunnelled"
msgstr "Przez tunel"

#. Connect page, Activity pane: label of the switch beside the search field that folds the list of connections into one row per host (with the count, the summed traffic and the latest decision). Clicking a host's row turns the switch off and searches for that host.
msgctxt "adv_group_by_host"
msgid "Group by host"
msgstr "Grupuj według hosta"

#. Connection inspector: label of the host row.
msgctxt "adv_host"
msgid "Host"
msgstr "Host"

#. Connect page, Advanced Mode, the connection inspector and an Activity row's menu: the confirmation after a press added a rule allowing the connection's host from now on.
msgctxt "adv_host_allowed"
msgid "This host will be allowed"
msgstr "Ten host będzie dozwolony"

#. Connect page, Advanced Mode, the connection inspector and an Activity row's menu: the confirmation after a press added a rule blocking the connection's host from now on.
msgctxt "adv_host_blocked"
msgid "This host will be blocked"
msgstr "Ten host będzie blokowany"

#. Connect page, Advanced Mode, the connection inspector and an Activity row's menu: the confirmation after a press added a split rule sending the connection's host outside the VPN tunnel from now on.
msgctxt "adv_host_bypassed"
msgid "This host will bypass the tunnel"
msgstr "Ten host będzie omijać tunel"

#. Connect page, Advanced Mode, the connection inspector and an Activity row's menu: the confirmation after a press added a rule keeping the connection's host inside the VPN tunnel from now on.
msgctxt "adv_host_tunnelled"
msgid "This host will use the tunnel"
msgstr "Ten host będzie korzystać z tunelu"

#. Connection inspector: heading of the inspector pane.
msgctxt "adv_inspector"
msgid "Inspector"
msgstr "Inspektor"

#. Kill switch: status while the change is being applied.
msgctxt "adv_kill_switch_applying"
msgid "Applying…"
msgstr "Stosowanie…"

#. Kill switch: how to restore normal access while the block is armed.
msgctxt "adv_kill_switch_armed_way_out"
msgid "Turn the kill switch off to restore normal access without connecting."
msgstr "Wyłącz Kill switch, aby przywrócić normalny dostęp bez łączenia się."

#. Settings, kill switch: Disconnect always restores the internet; the switch only covers drops the user did not ask for.
msgctxt "adv_kill_switch_deliberate"
msgid "Pressing Disconnect always restores your internet straight away. The kill switch only applies to drops you did not ask for - a tunnel that stops carrying traffic, a network change, or the URnetwork service stopping."
msgstr "Naciśnięcie Rozłącz zawsze natychmiast przywraca internet. Kill switch dotyczy tylko zerwań, o które nie prosiłeś - tunelu, który przestał przenosić ruch, zmiany sieci lub zatrzymania usługi URnetwork."

#. Settings, kill switch: what may leave the device while the switch is on, and the name-lookup window during a connection attempt.
msgctxt "adv_kill_switch_dns_window"
msgid "While it is on and nothing is connecting, nothing leaves this device - name lookups included. During a connection attempt, name lookups from any app on this device can leave in the clear so URnetwork can reach its servers; everything else stays blocked."
msgstr "Gdy jest włączony i nic się nie łączy, z tego urządzenia nie wychodzi nic - łącznie z zapytaniami o nazwy. Podczas próby połączenia zapytania o nazwy z dowolnej aplikacji na tym urządzeniu mogą wyjść niezaszyfrowane, aby URnetwork dotarł do swoich serwerów; cała reszta pozostaje zablokowana."

#. Settings: explanation under the kill switch switch.
msgctxt "adv_kill_switch_note"
msgid "If the tunnel drops unexpectedly, block this device's traffic instead of letting it out unprotected."
msgstr "Jeśli tunel nieoczekiwanie się zerwie, zablokuj ruch tego urządzenia zamiast wypuszczać go bez ochrony."

#. Kill switch: how to remove a block that is still in place when the device cannot reach the network; {command} is the shell command.
msgctxt "adv_kill_switch_recovery"
msgid "If this device cannot reach the network, a block installed earlier may still be in place; remove it with: {}"
msgstr "Jeśli to urządzenie nie może połączyć się z siecią, wcześniej zainstalowana blokada może nadal obowiązywać; usuń ją poleceniem: {}"

#. Kill switch status: in force and armed, only local traffic leaves until connected.
msgctxt "adv_kill_switch_state_armed"
msgid "In force: nothing but local network traffic leaves this device until you connect."
msgstr "Obowiązuje: dopóki się nie połączysz, z tego urządzenia wychodzi tylko ruch w sieci lokalnej."

#. Kill switch status: in force while connected, traffic is blocked if the tunnel drops.
msgctxt "adv_kill_switch_state_connected"
msgid "In force: if the tunnel drops, this device's traffic is blocked instead of going out unprotected."
msgstr "Obowiązuje: jeśli tunel się zerwie, ruch tego urządzenia zostanie zablokowany zamiast wyjść bez ochrony."

#. Kill switch status: the system service could not install the block.
msgctxt "adv_kill_switch_state_failed"
msgid "The URnetwork system service could not install the kill switch, so your traffic is NOT being blocked."
msgstr "Usługa systemowa URnetwork nie mogła zainstalować Kill switch, więc ruch nie jest blokowany."

#. Kill switch status: not in force, traffic is not blocked.
msgctxt "adv_kill_switch_state_not_in_force"
msgid "The kill switch is NOT in force: your traffic is not being blocked."
msgstr "Kill switch NIE obowiązuje: twój ruch nie jest blokowany."

#. Kill switch status: nothing is blocked yet, takes effect on connect.
msgctxt "adv_kill_switch_state_pending"
msgid "Nothing is blocked yet — this takes effect the moment you connect."
msgstr "Nic nie jest jeszcze blokowane — zacznie obowiązywać w chwili połączenia."

#. Kill switch status: the switch is off but the service still has a block installed, so traffic is blocked.
msgctxt "adv_kill_switch_state_still_installed"
msgid "The kill switch is off, but the URnetwork system service still has a block installed, so this device's traffic is being blocked."
msgstr "Kill switch jest wyłączony, ale usługa systemowa URnetwork nadal ma zainstalowaną blokadę, więc ruch tego urządzenia jest blokowany."

#. Kill switch status: cannot be checked right now.
msgctxt "adv_kill_switch_state_unknown"
msgid "Whether the kill switch is in force cannot be checked right now."
msgstr "Nie można teraz sprawdzić, czy Kill switch obowiązuje."

#. Kill switch: how to clear a block the service still has installed; {command} is the shell command to use if toggling does not work.
msgctxt "adv_kill_switch_still_installed_fix"
msgid "Turning the kill switch on and then off again asks the service to clear it; if that does not work, remove it with: {}"
msgstr "Włączenie i ponowne wyłączenie Kill switch prosi usługę o jej usunięcie; jeśli to nie zadziała, usuń ją poleceniem: {}"

#. Connection inspector: label of the last routing decision row.
msgctxt "adv_last_decision"
msgid "Last decision"
msgstr "Ostatnia decyzja"

#. Connection inspector: label of the matched rule row.
msgctxt "adv_matched"
msgid "Matched"
msgstr "Dopasowanie"

#. Windows status strip (Advanced Mode), Session value: a session that talks to the service over RPC without a tunnel. Lowercase, a short status value.
msgctxt "adv_mode_rpc_only"
msgid "rpc-only"
msgstr "tylko RPC"

#. Windows and Linux status strip (Advanced Mode), Session value: a full tunnel session. Lowercase, a short status value.
msgctxt "adv_mode_tunnel"
msgid "tunnel"
msgstr "tunel"

#. Connection inspector: placeholder dash for a value that is not available.
msgctxt "adv_na"
msgid "—"
msgstr "—"

#. Split rules sheet: the line in the Activity list when the search matches none of the connections it holds.
msgctxt "adv_no_activity_matches"
msgid "No activity matches this search."
msgstr "Brak aktywności pasującej do tego wyszukiwania."

#. Connection inspector: shown when no connection is selected.
msgctxt "adv_no_selection"
msgid "No connection selected"
msgstr "Nie wybrano połączenia"

#. Connection inspector: value shown when a field has nothing.
msgctxt "adv_none"
msgid "none"
msgstr "brak"

#. Connect page, Advanced Mode, the connection inspector: the end of the Reason value's name for screen readers when a rule decided the connection, because pressing the value opens the Split rules sheet. Lowercase: it follows a comma.
msgctxt "adv_open_split_rules"
msgid "open split rules"
msgstr "otwórz reguły podziału"

#. Connection inspector: label of the override id row.
msgctxt "adv_override_id"
msgid "Override"
msgstr "Nadpisanie"

#. Connection inspector: label of the total packets row.
msgctxt "adv_packets_total"
msgid "Packets (total)"
msgstr "Pakiety (łącznie)"

#. Network page, selected provider pane: note under the best available explanation, saying how to connect to a chosen location instead.
msgctxt "adv_pick_location_note"
msgid "Pick a country, region, city or device in the list to connect there instead."
msgstr "Wybierz z listy kraj, region, miasto lub urządzenie, aby połączyć się tam."

#. Connection inspector: label of the probe age row.
msgctxt "adv_probe_age"
msgid "Probe age"
msgstr "Wiek sondy"

#. Connection inspector: label of the protected row.
msgctxt "adv_protected"
msgid "Protected"
msgstr "Chronione"

#. Network page: error when the provider list could not be loaded.
msgctxt "adv_providers_load_failed"
msgid "Could not load the provider list."
msgstr "Nie udało się wczytać listy dostawców."

#. Connection inspector (Linux) and Advanced Mode status strip (Windows): label of the raw status field.
msgctxt "adv_raw_status"
msgid "Raw status"
msgstr "Surowy stan"

#. Connection inspector: label of the decision reason row.
msgctxt "adv_reason"
msgid "Reason"
msgstr "Powód"

#. Connection inspector: decision reason, a block override applied.
msgctxt "adv_reason_block"
msgid "Block override"
msgstr "Nadpisanie blokady"

#. Connection inspector: decision reason, the default policy applied.
msgctxt "adv_reason_default"
msgid "Default policy"
msgstr "Zasada domyślna"

#. Connection inspector: decision reason, an override applied.
msgctxt "adv_reason_override"
msgid "Override"
msgstr "Nadpisanie"

#. Connection inspector: decision reason, a route override applied.
msgctxt "adv_reason_route"
msgid "Route override"
msgstr "Nadpisanie trasy"

#. Windows and Linux status strip (Advanced Mode): label of the field that shows whether the tunnel's routes are installed.
msgctxt "adv_routes"
msgid "Routes"
msgstr "Trasy"

#. Windows and Linux status strip (Advanced Mode), Routes value: routes are installed but the tunnel's DNS is not. Lowercase, a short status value.
msgctxt "adv_routes_dns_degraded"
msgid "on, dns not applied"
msgstr "włączone, DNS niezastosowany"

#. Windows and Linux status strip (Advanced Mode), Routes value: no routes are installed and the kill switch is blocking traffic. Lowercase, a short status value.
msgctxt "adv_routes_kill_switch_armed"
msgid "off, kill switch armed"
msgstr "wyłączone, Kill switch uzbrojony"

#. Windows status strip (Advanced Mode), Routes value: routes are installed but no leak-prevention firewall policy is in force. Lowercase, a short status value.
msgctxt "adv_routes_no_firewall"
msgid "on, no leak guard"
msgstr "włączone, bez ochrony przed wyciekami"

#. Windows and Linux status strip (Advanced Mode): label of the field that shows the service's RPC endpoint (host:port). RPC is a technical term.
msgctxt "adv_rpc"
msgid "RPC"
msgstr "RPC"

#. Connect page, Advanced Mode, the connection inspector and an Activity row's menu: added to a rule button's name for screen readers, after its label, while the button's rule is in force: pressing it removes the rule. Lowercase: it follows a comma.
msgctxt "adv_rule_active"
msgid "rule active, click to remove"
msgstr "reguła aktywna, kliknij, aby usunąć"

#. Connect page, Advanced Mode, the connection inspector and an Activity row's menu: the confirmation after a press removed the rule that was in force for the connection's host.
msgctxt "adv_rule_removed"
msgid "Rule removed"
msgstr "Usunięto regułę"

#. Split rules sheet: placeholder and accessible name of the search field above the Activity list. Typing filters the list to the connections whose host name or IP address contains the text; the rules above are not filtered.
msgctxt "adv_search_activity_placeholder"
msgid "Search activity"
msgstr "Szukaj w aktywności"

#. Connect page, Activity pane: placeholder and accessible name of the search field above the list of connections. Typing filters the list to the connections whose host name or IP address contains the text.
msgctxt "adv_search_connections"
msgid "Search hosts or IPs"
msgstr "Szukaj hostów lub adresów IP"

#. Connection inspector: hint to select a row in the Activity list.
msgctxt "adv_select_a_row"
msgid "Select a row in Activity to inspect it"
msgstr "Wybierz wiersz w Aktywności, aby go sprawdzić"

#. Connection inspector: suffix after the count of selected rows.
msgctxt "adv_selected"
msgid "selected"
msgstr "zaznaczono"

#. Connection inspector: shown when the selected connection is no longer listed.
msgctxt "adv_selection_gone"
msgid "That connection is no longer listed"
msgstr "To połączenie nie jest już na liście"

#. Connection inspector: label of the session exit country row.
msgctxt "adv_session_exit_country"
msgid "Session exit country"
msgstr "Kraj wyjścia sesji"

#. Windows and Linux status strip (Advanced Mode): label of the field that shows which kind of session the service granted (tunnel or rpc-only).
msgctxt "adv_session_mode"
msgid "Session"
msgstr "Sesja"

#. Split rules sheet: the one-sentence explainer at the top, above the note on network clusters. A split rule sends the chosen sites directly from this device, outside the VPN; the sheet's Activity list shows how each connection was routed.
msgctxt "adv_split_rules_note"
msgid "Split rules let the sites you choose connect directly, outside the VPN, and the activity below shows how each connection was routed."
msgstr "Reguły podziału pozwalają wybranym witrynom łączyć się bezpośrednio, poza VPN, a aktywność poniżej pokazuje, jak zostało przekierowane każde połączenie."

#. Connect page, Advanced Mode, the connection inspector and an Activity row's menu: the button on the confirmation after a press added a rule; it deletes the rule that was just added.
msgctxt "adv_undo"
msgid "Undo"
msgstr "Cofnij"

#. Connection inspector: exit value when the destination is not in the routing table.
msgctxt "adv_unknown_exit"
msgid "Not in the routing table"
msgstr "Brak w tablicy routingu"

#. Connect page, Advanced Mode: the label of the verdict line (blocked, tunnelled, or bypassed the tunnel) in the connection details Copy details puts on the clipboard.
msgctxt "adv_verdict"
msgid "Verdict"
msgstr "Werdykt"

#. Connection inspector: verdict, the connection was blocked and no packets were sent.
msgctxt "adv_verdict_blocked"
msgid "Blocked — no packets sent"
msgstr "Zablokowano — nie wysłano pakietów"

#. Connection inspector: verdict, the connection bypassed the tunnel and is not protected.
