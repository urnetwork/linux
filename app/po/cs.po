#. Connect error: the system service could not check whether the account may connect.
msgctxt "daemon_auth_check_failed"
msgid "The URnetwork system service could not check whether this account is allowed to connect, so it did not connect. Try again."
msgstr "Systémová služba URnetwork nemohla ověřit, zda se tento účet smí připojit, a tak se nepřipojila. Zkuste to znovu."

#. Connect error: the device policy does not allow this account to connect.
msgctxt "daemon_auth_denied"
msgid "This device's policy does not allow this account to connect through URnetwork. An administrator can change that."
msgstr "Zásady tohoto zařízení tomuto účtu nedovolují připojit se přes URnetwork. Správce to může změnit."

#. Connect error: administrator permission is needed from this session.
msgctxt "daemon_auth_required"
msgid "Connecting from this session needs administrator permission. Press Connect again to be asked, or use the session at this device's screen."
msgstr "Připojení z této relace vyžaduje oprávnění správce. Stiskněte znovu Připojit, abyste byli dotázáni, nebo použijte relaci na obrazovce tohoto zařízení."

#. Connect error: the permission request was not answered.
msgctxt "daemon_auth_timeout"
msgid "The permission request was not answered, so nothing was connected. Press Connect to try again."
msgstr "Na žádost o oprávnění nikdo neodpověděl, takže se nic nepřipojilo. Stiskněte Připojit a zkuste to znovu."

#. Connect error: no polkit service, the daemon falls back to the urnetwork group.
msgctxt "daemon_auth_unavailable"
msgid "This device has no polkit authorization service, so the URnetwork system service falls back to the 'urnetwork' group. Add your user to it and sign out and back in."
msgstr "Toto zařízení nemá autorizační službu polkit, takže systémová služba URnetwork používá skupinu 'urnetwork'. Přidejte do ní svého uživatele a odhlaste se a znovu přihlaste."

#. Error: the system service did not answer.
msgctxt "daemon_no_answer"
msgid "The URnetwork system service did not answer."
msgstr "Systémová služba URnetwork neodpověděla."

#. Shown on the linux home screen when the app and the urnetworkd system service carry different URnetwork SDK builds (they update on independent schedules and must match exactly). The fix is updating both to the same release.
msgctxt "daemon_sdk_mismatch"
msgid "The app and the URnetwork system service are different builds. Update both to the same version."
msgstr "Aplikace a systémová služba URnetwork jsou různá sestavení. Aktualizujte obojí na stejnou verzi."

#. Shown on the linux home screen when the installed urnetworkd system service speaks an older control protocol than this app supports. Distinct from daemon_unreachable by contract; the fix is updating the service, not the app.
msgctxt "daemon_too_old"
msgid "The URnetwork system service is out of date. Update it to connect."
msgstr "Systémová služba URnetwork je zastaralá. Pro připojení ji aktualizujte."

#. Connect error: another user on the device holds the tunnel.
msgctxt "daemon_tunnel_owned_by_other_user"
msgid "Another user on this device is connected through URnetwork. Disconnect it from their session, or take it over with administrator permission."
msgstr "Jiný uživatel na tomto zařízení je připojen přes URnetwork. Odpojte ho z jeho relace, nebo připojení převezměte s oprávněním správce."

#. Shown on the linux home screen when the privileged urnetworkd system service cannot be reached over its control socket (not installed, not running, or the user lacks access). Distinct from daemon_too_old by contract.
msgctxt "daemon_unreachable"
msgid "The URnetwork system service is not running. Install or start it, then try again."
msgstr "Systémová služba URnetwork neběží. Nainstalujte ji nebo spusťte a zkuste to znovu."

