#. The VLESS settings: the Settings row and screen title, and the row on the login screen's network settings. VLESS is a proxy protocol name.
msgctxt "vless"
msgid "VLESS"
msgstr "VLESS"

#. VLESS settings: the switch that skips the VLESS server's certificate check (TLS only). The app's own traffic stays encrypted.
msgctxt "vless_allow_insecure"
msgid "Allow an insecure certificate"
msgstr "असुरक्षित प्रमाणपत्र की अनुमति दें"

#. VLESS settings: the TLS ALPN list field label. A protocol term.
msgctxt "vless_alpn"
msgid "ALPN"
msgstr "ALPN"

#. VLESS settings: the button that copies the settings as a vless:// share link.
msgctxt "vless_copy_link"
msgid "Copy link"
msgstr "लिंक कॉपी करें"

#. VLESS settings: the switch that turns the VLESS server on or off.
msgctxt "vless_enabled"
msgid "Use VLESS"
msgstr "VLESS का उपयोग करें"

#. VLESS settings error: the server address is missing or malformed.
msgctxt "vless_error_address_invalid"
msgid "Enter the server address."
msgstr "सर्वर का पता दर्ज करें।"

#. VLESS settings error: the TLS fingerprint name is not one this app knows.
msgctxt "vless_error_fingerprint_unsupported"
msgid "This TLS fingerprint is not supported."
msgstr "यह TLS फ़िंगरप्रिंट सपोर्टेड नहीं है।"

#. VLESS settings error: the Vision flow needs the TCP transport and TLS or REALITY security, or the flow is unknown. Vision, TCP, TLS and REALITY are protocol names.
msgctxt "vless_error_flow_invalid"
msgid "The Vision flow works only with the TCP transport and TLS or REALITY security."
msgstr "Vision फ़्लो सिर्फ़ TCP ट्रांसपोर्ट और TLS या REALITY सुरक्षा के साथ काम करता है।"

#. VLESS settings error: the user ID is missing or is not a UUID (or a custom ID of up to 30 bytes).
msgctxt "vless_error_id_invalid"
msgid "Enter the user ID (a UUID)."
msgstr "यूज़र आईडी (UUID) दर्ज करें।"

#. VLESS settings error: the pasted text is not a vless:// share link.
msgctxt "vless_error_link_invalid"
msgid "This is not a valid VLESS link."
msgstr "यह मान्य VLESS लिंक नहीं है।"

#. VLESS settings error: the link asks for a VLESS feature this app does not implement (for example VLESS encryption).
msgctxt "vless_error_link_unsupported"
msgid "This link uses a VLESS feature this app does not support."
msgstr "यह लिंक VLESS की ऐसी सुविधा का उपयोग करता है जिसे यह ऐप सपोर्ट नहीं करता।"

#. VLESS settings error: the transport is one this app does not implement (for example gRPC or XHTTP). TCP, WebSocket and HTTPUpgrade are protocol names.
msgctxt "vless_error_network_unsupported"
msgid "This transport is not supported. Use TCP, WebSocket or HTTPUpgrade."
msgstr "यह ट्रांसपोर्ट सपोर्टेड नहीं है। TCP, WebSocket या HTTPUpgrade का उपयोग करें।"

#. VLESS settings error: the port is missing or outside 1 to 65535.
msgctxt "vless_error_port_invalid"
msgid "Enter a port from 1 to 65535."
msgstr "1 से 65535 तक का पोर्ट दर्ज करें।"

#. VLESS settings error: the REALITY public key is missing or is not 32 bytes of base64. REALITY is a protocol name.
msgctxt "vless_error_public_key_invalid"
msgid "Enter the REALITY public key."
msgstr "REALITY की पब्लिक की दर्ज करें।"

#. VLESS settings error: the security type is one this app does not implement. TLS and REALITY are protocol names.
msgctxt "vless_error_security_unsupported"
msgid "This security type is not supported. Use TLS, REALITY or none."
msgstr "यह सुरक्षा प्रकार सपोर्टेड नहीं है। TLS, REALITY या कोई नहीं चुनें।"

#. VLESS settings error: REALITY needs the server name (SNI) of the site it borrows. REALITY and SNI are protocol names.
msgctxt "vless_error_server_name_required"
msgid "Enter the server name (SNI) for REALITY."
msgstr "REALITY के लिए सर्वर नाम (SNI) दर्ज करें।"

#. VLESS settings error: the REALITY short ID is longer than 16 hexadecimal characters or is not hexadecimal. REALITY is a protocol name.
msgctxt "vless_error_short_id_invalid"
msgid "The REALITY short ID must be up to 16 hexadecimal characters."
msgstr "REALITY शॉर्ट आईडी में अधिकतम 16 हेक्साडेसिमल अक्षर हो सकते हैं।"

#. VLESS settings: the picker of the browser TLS hello the connection imitates (chrome, firefox, ...).
msgctxt "vless_fingerprint"
msgid "TLS fingerprint"
msgstr "TLS फ़िंगरप्रिंट"

#. VLESS settings: the flow picker label (none or Vision). A VLESS protocol term.
