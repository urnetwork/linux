#. Licenses screen: section header for the open source libraries and fonts
msgctxt "licenses_software_header"
msgid "Open source software"
msgstr "ओपन सोर्स सॉफ़्टवेयर"

#. A description of the add auth sheet.
msgctxt "link_another_way_to_sign_in_to"
msgid "Link another way to sign in to your account."
msgstr "अपने खाते में साइन इन करने का एक और तरीका लिंक करें।"

#. A section (points, wallet, referral code, epoch history, payout wallet) could not be loaded. Shown in place of the loading spinner or the section's data, next to a Try again (Retry on apple) button.
msgctxt "load_failed"
msgid "Couldn't load. Check your connection and try again."
msgstr "लोड नहीं हो सका। अपना कनेक्शन जाँचें और दोबारा कोशिश करें।"

#. Used in ContentView.swift.
msgctxt "loading"
msgid "Loading..."
msgstr "लोड हो रहा है..."

msgctxt "loading_sign_in_methods"
msgid "Loading sign-in methods..."
msgstr "साइन-इन विधियाँ लोड हो रही हैं..."

#. Label for a chart showing local traffic statistics.
msgctxt "local"
msgid "Local"
msgstr "स्थानीय"

#. A label displayed in the custom dns settings section.
msgctxt "local_dns"
msgid "Local DNS"
msgstr "स्थानीय DNS"

#. A label displayed above a list of local DNS servers.
msgctxt "local_dns_servers"
msgid "Local DNS servers"
msgstr "स्थानीय DNS सर्वर"

