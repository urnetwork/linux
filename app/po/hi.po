msgstr "डिफ़ॉल्ट नीति"

#. Connection inspector: decision reason, an override applied.
msgctxt "adv_reason_override"
msgid "Override"
msgstr "ओवरराइड"

#. Connection inspector: decision reason, a route override applied.
msgctxt "adv_reason_route"
msgid "Route override"
msgstr "रूट ओवरराइड"

