msgstr "URnetwork में आपका स्वागत है"

#. Used in Main/Account/Settings/UpdateReferralNetworkSheet/UpdateReferralNetworkSheet.swift.
msgctxt "when_unlinking_your_referral_network_you_will_no"
msgid "When unlinking your referral network, you will no longer be able to earn points from {}."
msgstr "अपना रेफ़रल नेटवर्क अनलिंक करने पर, आप {} से अंक अर्जित नहीं कर पाएंगे।"

#. Call to action
msgctxt "when_you_refer_a_friend"
msgid "When you refer a friend:"
msgstr "जब आप किसी मित्र को रेफ़र करते हैं:"

#. Account: the Widgets section (quick connect control and Home Screen widgets, with how to add them).
msgctxt "widgets"
msgid "Widgets"
msgstr "विजेट"

#. Connect drawer: the auto connection mode (no fixed window type).
msgctxt "window_type_auto"
msgid "Auto"
msgstr "स्वचालित"

#. A button label that says "Web".
msgctxt "window_type_quality"
msgid "Web"
msgstr "वेब"

#. A choice for connecting to a tunnel in streaming mode.
msgctxt "window_type_speed"
msgid "Streaming"
msgstr "स्ट्रीमिंग"

#. Onboarding Carousel
msgctxt "with_urnetwork"
msgid "with URnetwork"
msgstr "URnetwork के साथ"

#. A warning message that instructs the user to write down their seedphrase and store it in a secure location.
msgctxt "write_it_down_and_store_it_somewhere"
msgid "Write it down and store it somewhere safe. If you lose it, you'll lose access to your account."
msgstr "इसे लिखकर किसी सुरक्षित जगह पर रखें। अगर यह खो गया, तो आप अपने खाते तक पहुंच खो देंगे।"

#. Billing period name on the yearly subscription product card in the upgrade flow.
msgctxt "yearly"
msgid "Yearly"
msgstr "वार्षिक"

#. Call to action
msgctxt "yes"
msgid "Yes"
msgstr "हाँ"

#. Used in Shared/Views/Introduction/ParticipateReferView.swift.
msgctxt "you_get_30_gib_month_for_life"
msgid "You get 30 GiB/month for life"
msgstr "आपको जीवनभर के लिए 30 GiB/माह मिलता है"

#. Text displayed in a scrollable view within a VStack in the body of a view that is displayed when the user is viewing their referral code.
msgctxt "you_get_3_gib_day_for_life"
msgid "You get 3 GiB/day for life"
msgstr "आपको जीवनभर 3 GiB/दिन मिलते हैं"

msgctxt "you_have_1_other_device_online"
