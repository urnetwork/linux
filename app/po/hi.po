msgctxt "unencrypted_dns"
msgid "Unencrypted DNS"
msgstr "अनएन्क्रिप्टेड DNS"

#. Fallback shown in place of a value that is not known, e.g. the host list of a blocked connection or the peer client id in the connection stats. Lowercase: it appears inline where a value would be.
msgctxt "unknown"
msgid "unknown"
msgstr "अज्ञात"

