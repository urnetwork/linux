msgctxt "transport_auto_degraded_memory"
msgid "Auto is degraded because system memory limits prevent some enabled transports from running."
msgstr "Kiotomatiki kinafanya kazi kwa kiwango cha chini kwa sababu vikomo vya kumbukumbu ya mfumo vinazuia baadhi ya usafirishaji uliowashwa kufanya kazi."

#. Subtitle of the Auto transport mode row.
msgctxt "transport_auto_description"
msgid "Recommended. Uses the enabled transports below."
msgstr "Inapendekezwa. Hutumia usafirishaji uliowashwa hapa chini."

#. Footer of the client transport mode section.
msgctxt "transport_client_footer"
msgid "The transport this device uses to reach providers. Auto tries the enabled transports in preference order and keeps every healthy transport of the same tier connected in parallel."
msgstr "Usafirishaji ambao kifaa hiki hutumia kufikia watoa huduma. Kiotomatiki hujaribu usafirishaji uliowashwa kwa mpangilio wa upendeleo na hudumisha kila usafirishaji wenye afya wa daraja moja ukiwa umeunganishwa sambamba."

#. Transport name: the DNS-disguised transport. A product name; never translated.
msgctxt "transport_dns"
msgid "whodis"
msgstr "whodis"

#. One line description of the whodis (DNS) transport in the transport settings editor.
msgctxt "transport_dns_description"
msgid "Disguised as DNS traffic. For networks that filter direct connections."
msgstr "Hujificha kama trafiki ya DNS. Kwa mitandao inayochuja miunganisho ya moja kwa moja."

#. Transport name: the DNS-disguised transport with a reply pump. A product name; never translated.
msgctxt "transport_dnspump"
msgid "whodis pump"
msgstr "whodis pump"

#. One line description of the whodis pump (DNS pump) transport in the transport settings editor.
msgctxt "transport_dnspump_description"
msgid "Disguised as DNS traffic with a constant reply pump. Lowest bandwidth, highest availability."
msgstr "Hujificha kama trafiki ya DNS yenye pampu ya majibu isiyokoma. Kipimo data cha chini zaidi, upatikanaji wa juu zaidi."

#. Transport name: HTTP/1.1 over TLS. A protocol name; never translated.
msgctxt "transport_h1"
msgid "H1"
msgstr "H1"

#. One line description of the H1 transport in the transport settings editor.
msgctxt "transport_h1_description"
msgid "Direct over TLS. Works on most networks."
msgstr "Moja kwa moja kupitia TLS. Hufanya kazi kwenye mitandao mingi."

#. Transport name: HTTP/3 over QUIC. A protocol name; never translated.
msgctxt "transport_h3"
msgid "H3"
msgstr "H3"

#. One line description of the H3 transport in the transport settings editor.
msgctxt "transport_h3_description"
msgid "Direct over QUIC. Fastest where it is not filtered."
msgstr "Moja kwa moja kupitia QUIC. Ndio wa kasi zaidi pale usipochujwa."

#. Transport name: peer to peer. A protocol name; never translated.
msgctxt "transport_p2p"
msgid "P2P"
msgstr "P2P"

#. Footer of the provider transport mode section.
msgctxt "transport_provider_footer"
msgid "The transport this device uses while providing for others. Auto tries the enabled transports in preference order and keeps every healthy transport of the same tier connected in parallel."
msgstr "Usafirishaji ambao kifaa hiki hutumia kinapotoa huduma kwa wengine. Kiotomatiki hujaribu usafirishaji uliowashwa kwa mpangilio wa upendeleo na hudumisha kila usafirishaji wenye afya wa daraja moja ukiwa umeunganishwa sambamba."

#. Transport bar label for traffic admitted for sending but not yet attributed to a physical transport.
msgctxt "transport_queued"
msgid "queued"
msgstr "kwenye foleni"

#. Accessibility label / tooltip on the warning icon next to a transport that is enabled under Auto but not currently eligible under a system constraint (for example the platform memory budget). A runtime warning, not a settings restriction: the toggle stays editable.
msgctxt "transport_unavailable_system_constraints"
msgid "Unavailable due to system constraints"
msgstr "Haupatikani kwa sababu ya vikwazo vya mfumo"

#. Prefix of the transport bar footer listing the enabled transports that carried no traffic in the stats window.
msgctxt "transport_unused"
msgid "unused"
msgstr "haitumiki"

