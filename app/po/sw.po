msgid "with URnetwork"
msgstr "na URnetwork"

#. A warning message that instructs the user to write down their seedphrase and store it in a secure location.
msgctxt "write_it_down_and_store_it_somewhere"
msgid "Write it down and store it somewhere safe. If you lose it, you'll lose access to your account."
msgstr "Kiandike na ukihifadhi mahali salama. Ukikipoteza, utapoteza ufikiaji wa akaunti yako."

#. Billing period name on the yearly subscription product card in the upgrade flow.
msgctxt "yearly"
msgid "Yearly"
msgstr "Kila mwaka"

#. Call to action
msgctxt "yes"
msgid "Yes"
msgstr "Ndiyo"

#. Used in Shared/Views/Introduction/ParticipateReferView.swift.
msgctxt "you_get_30_gib_month_for_life"
msgid "You get 30 GiB/month for life"
msgstr "Unapata 30 GiB/mwezi maisha yote"

#. Text displayed in a scrollable view within a VStack in the body of a view that is displayed when the user is viewing their referral code.
msgctxt "you_get_3_gib_day_for_life"
msgid "You get 3 GiB/day for life"
msgstr "Unapata 3 GiB/siku maisha yote"

msgctxt "you_have_1_other_device_online"
msgid "You have 1 other device online"
msgstr "Una kifaa kingine 1 mtandaoni"

msgctxt "you_have_n_other_devices_online"
msgid "You have {} other devices online"
msgstr "Una vifaa vingine {} mtandaoni"

#. Used in Shared/Views/UpgradeSubscriptionSheet.swift.
msgctxt "you_ll_unlock_even_faster_speeds_and_first_dibs"
msgid "You'll unlock even faster speeds, and first dibs on new features like robust anti-censorship measures and data control."
msgstr "Utafungua kasi za juu zaidi, na kuwa wa kwanza kupata vipengele vipya kama vile hatua imara dhidi ya ukaguzi wa mtandao na udhibiti wa data."

#. Used in Authenticate/ResetPassword/ResetPasswordView.swift.
msgctxt "you_may_need_to_your_check_spam_folder_or"
msgid "You may need to your check spam folder or unblock no-reply@ur.io"
msgstr "Huenda ukahitaji kuangalia folda yako ya barua taka au kuondoa kizuizi kwa no-reply@ur.io"

#. Used in Shared/Views/AccountPointsBreakdown.swift.
msgctxt "you_re_earning_2x_points"
msgid "You're earning 2x points"
msgstr "Unapata pointi 2x"

#. Used in Main/Account/AccountRootView.swift.
msgctxt "you_re_premium"
msgid "You're premium."
msgstr "Wewe ni premium."

#. Label for the empty text field.
msgctxt "your_email"
msgid "Your email"
msgstr "Barua pepe yako"

#. Used in Shared/Views/Introduction/ParticipateReferView.swift.
msgctxt "your_friend_gets_30_gib_month_for_life"
msgid "Your friend gets 30 GiB/month for life"
msgstr "Rafiki yako anapata 30 GiB/mwezi maisha yote"

#. Text displayed in a scrollable view within a VStack in the body of a view that is displayed in a modal.
msgctxt "your_friend_gets_3_gib_day_for"
msgid "Your friend gets 3 GiB/day for life"
msgstr "Rafiki yako anapata 3 GiB/siku maisha yote"

#. Used in Shared/Views/UpgradeSubscriptionSheet.swift.
msgctxt "your_purchase_needs_to_be_approved_before_it_can"
msgid "Your purchase needs to be approved before it can complete. UR Pro will turn on by itself once it goes through — there's no need to buy again."
msgstr "Ununuzi wako unahitaji kuidhinishwa kabla ya kukamilika. UR Pro itawashwa yenyewe mara idhini itakapokamilika — huhitaji kununua tena."

#. Used in Shared/Views/Introduction/ParticipateReferView.swift.
msgctxt "your_referral_link"
