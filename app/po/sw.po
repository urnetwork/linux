msgctxt "delete_account_type_network_name"
msgid "Type {} to confirm."
msgstr "Andika {} ili kuthibitisha."

#. Developer page: report line when the SDK refused a requested action.
msgctxt "dev_action_declined"
msgid "No change: the SDK declined that action."
msgstr "Hakuna mabadiliko: SDK ilikataa kitendo hicho."

#. Developer page: note that the action buttons only request changes.
msgctxt "dev_actions_are_requests"
msgid "Actions are requests: confirm them in the measurements and exit rows, which refresh underneath."
msgstr "Vitendo ni maombi: thibitisha matokeo yake kwenye vipimo na safu za njia za kutoka, zinazojisasisha hapa chini."

#. Developer tools screen (reliability surface): performance-aware affinity control label.
msgctxt "dev_affinity_performance"
msgid "Performance-aware affinity"
msgstr "Mshikamano unaozingatia utendaji"

#. Developer tools screen: explanatory subtext under the performance-aware affinity control.
msgctxt "dev_affinity_performance_detail"
msgid "Weight new TLS races by each provider's peak acknowledged-byte rate relative to its advertised bandwidth. With hard affinity enabled, low measured donors yield to the race. Existing connections and explicit pins stay fixed"
msgstr "Pima mashindano mapya ya TLS kwa kasi ya juu ya baiti zilizothibitishwa za kila mtoa huduma ikilinganishwa na kipimo data alichotangaza. Mshikamano mkali ukiwashwa, watoa huduma wenye vipimo vya chini hupisha mashindano. Miunganisho iliyopo na ubanaji uliowekwa wazi hubaki vilevile"

#. Developer tools screen (reliability surface): affinity sticky control label.
msgctxt "dev_affinity_sticky"
msgid "Sticky site affinity"
msgstr "Mshikamano wa kudumu wa tovuti"

#. Developer tools screen: explanatory subtext under the 'affinity sticky' control.
msgctxt "dev_affinity_sticky_detail"
msgid "A site's new connections stay on the exit its earlier ones already use, even past the flow cap, so a busy site keeps one egress IP. The cap still limits which exits collect new sites. Off restores the strict cap"
msgstr "Miunganisho mipya ya tovuti hubaki kwenye njia ya kutoka ambayo miunganisho yake ya awali tayari inatumia, hata kupita kikomo cha mitiririko, ili tovuti yenye shughuli nyingi ibaki na IP moja ya kutokea. Kikomo bado huamua njia zipi za kutoka zinapokea tovuti mpya. Kuzima kunarejesha kikomo kikali"

#. Developer page: what a setting's 0 means when it probes every host ('Probe hosts per pass').
msgctxt "dev_all"
msgid "All"
msgstr "Zote"

#. Developer page: label of the app version row.
msgctxt "dev_app_version"
msgid "App version"
msgstr "Toleo la programu"

#. Developer tools screen (reliability surface): behaviour control label.
msgctxt "dev_behaviour"
msgid "Behaviour"
msgstr "Tabia"

#. Developer tools screen (reliability surface): blackhole receive control label.
msgctxt "dev_blackhole_receive"
msgid "Keep quiet providers longer"
msgstr "Weka watoa huduma walio kimya kwa muda mrefu zaidi"

#. Developer tools screen: explanatory subtext under the 'blackhole receive' control.
msgctxt "dev_blackhole_receive_detail"
msgid "How long a provider still acknowledging traffic may return nothing before it is dropped. Off keeps them until they stop acknowledging"
msgstr "Muda ambao mtoa huduma ambaye bado anathibitisha trafiki anaweza kukaa bila kurudisha chochote kabla ya kuondolewa. Kuzima kunawaweka hadi watakapoacha kuthibitisha"

#. Developer tools screen (reliability surface): blast radius control label.
msgctxt "dev_blast_radius"
msgid "Blast radius"
msgstr "Upana wa athari"

#. Developer tools screen: explanatory subtext under the 'blast radius' control.
msgctxt "dev_blast_radius_detail"
msgid "Connections lost per provider failure. Lower is better"
msgstr "Miunganisho inayopotea kwa kila hitilafu ya mtoa huduma. Chache ni bora"

#. Developer tools screen: formatted value readout for 'blast radius'.
msgctxt "dev_blast_radius_value"
msgid "{} per failure"
msgstr "{} kwa kila hitilafu"

#. Developer tools screen (reliability surface): busy probe control label.
msgctxt "dev_busy_probe"
msgid "Probe stalled exits before dropping"
msgstr "Pima njia za kutoka zilizokwama kabla ya kuziondoa"

#. Developer tools screen (reliability surface): busy probe budget control label.
msgctxt "dev_busy_probe_budget"
msgid "Busy probe wait"
msgstr "Muda wa kusubiri wa kipimo cha shughuli"

#. Developer tools screen: explanatory subtext under the 'busy probe budget' control.
msgctxt "dev_busy_probe_budget_detail"
msgid "How long the stall probe waits for an answer before convicting. Off derives half the stall bar"
msgstr "Muda ambao kipimo cha kukwama husubiri jibu kabla ya kuhukumu. Kuzima kunatumia nusu ya kizingiti cha kukwama"

#. Developer tools screen: explanatory subtext under the 'busy probe' control.
msgctxt "dev_busy_probe_detail"
msgid "When an exit stalls, ping it once before convicting. A congested but alive exit answers and keeps its flows; a dead one is still dropped. Off convicts on the stall bar"
msgstr "Njia ya kutoka inapokwama, inapigiwa ping mara moja kabla ya kuhukumiwa. Njia yenye msongamano lakini iliyo hai hujibu na kubaki na mitiririko yake; iliyokufa huondolewa vilevile. Kuzima kunahukumu kwenye kizingiti cha kukwama"

#. Developer page: label of the 'Busy probe wait' setting.
msgctxt "dev_busy_probe_wait"
msgid "Busy probe wait"
msgstr "Muda wa kusubiri wa kipimo cha shughuli"

#. Developer page: the explanation under the 'Busy probe wait' setting.
msgctxt "dev_busy_probe_wait_detail"
msgid "How long the stall probe waits for an answer before convicting, in ms. Off derives half the stall bar"
msgstr "Muda ambao kipimo cha kukwama husubiri jibu kabla ya kuhukumu, kwa ms. Kuzima kunatumia nusu ya kizingiti cha kukwama"

#. Developer tools screen (reliability surface): busy probes control label.
msgctxt "dev_busy_probes"
msgid "Busy probes"
msgstr "Vipimo vya shughuli"

#. Developer tools screen: explanatory subtext under the 'busy probes' control.
msgctxt "dev_busy_probes_detail"
msgid "Liveness pings fired at stalled exits; acquitted ones answered and were kept, the removals the probe prevented"
msgstr "Ping za kukagua uhai zilizotumwa kwa njia za kutoka zilizokwama; zilizoachiliwa zilijibu na kubakizwa — hizi ndizo uondoaji ambao kipimo kilizuia"

#. Developer tools screen: formatted value readout for 'busy probes'.
msgctxt "dev_busy_probes_value"
msgid "{0} sent / {1} acquitted"
msgstr "Zilizotumwa {0} / zilizoachiliwa {1}"

#. Developer page: button that checks for a new release now. Linux Settings > General: the title of the row whose button does the same.
msgctxt "dev_check_updates"
msgid "Check for updates"
msgstr "Angalia masasisho"

#. Developer tools screen: action for choosing individual log files to export.
msgctxt "dev_choose_logs"
msgid "Choose logs…"
msgstr "Chagua kumbukumbu…"

#. Developer tools screen: action that deletes the diagnostics log files without touching local state, preferences or rules.
msgctxt "dev_clear_logs"
msgid "Clear logs"
msgstr "Futa kumbukumbu"

#. Developer tools screen: the clear-logs action's label while it runs.
msgctxt "dev_clearing_logs"
msgid "Clearing logs…"
msgstr "Inafuta kumbukumbu…"

#. Developer tools screen (reliability surface): cluster affinity control label.
msgctxt "dev_cluster_affinity"
msgid "Group IPs by site"
msgstr "Panga IP kwa tovuti"

#. Developer tools screen: explanatory subtext under the 'cluster affinity' control.
msgctxt "dev_cluster_affinity_detail"
msgid "Keeps a site on one exit when its hostname is not visible"
msgstr "Huweka tovuti kwenye njia moja ya kutoka wakati jina la seva yake halionekani"

#. Developer page: table column header for the per-row action buttons.
msgctxt "dev_col_actions"
msgid "Actions"
msgstr "Vitendo"

#. Developer page: table column header for the connect timing.
msgctxt "dev_col_connect"
msgid "Connect"
msgstr "Kuunganisha"

#. Developer page: table column header for a destination host.
msgctxt "dev_col_destination"
msgid "Destination"
msgstr "Lengo"

#. Developer page: table column header for the DNS timing. A protocol name; never translated.
msgctxt "dev_col_dns"
msgid "DNS"
msgstr "DNS"

#. Developer page: table column header for the exit a flow uses.
msgctxt "dev_col_exit"
msgid "Exit"
msgstr "Njia ya kutoka"

#. Developer page: table column header for the number of failed dials.
msgctxt "dev_col_failed_dials"
msgid "Failed dials"
msgstr "Upigaji ulioshindwa"

#. Developer page: table column header for the number of flows.
msgctxt "dev_col_flows"
msgid "Flows"
msgstr "Mitiririko"

#. Developer page: table column header for the probe kind.
msgctxt "dev_col_kind"
msgid "Kind"
msgstr "Aina"

#. Developer page: table column header for a probe outcome.
msgctxt "dev_col_outcome"
msgid "Outcome"
msgstr "Matokeo"

#. Developer page: table column header for an exit state.
msgctxt "dev_col_state"
msgid "State"
msgstr "Hali"

#. Developer page: table column header for a probe target.
msgctxt "dev_col_target"
msgid "Target"
msgstr "Shabaha"

#. Developer page: table column header for an exit tier.
msgctxt "dev_col_tier"
msgid "Tier"
msgstr "Daraja"

#. Developer page: table column header for the total timing.
msgctxt "dev_col_total"
msgid "Total"
msgstr "Jumla"

#. Developer page: table column header for time to first byte. The metric's standard abbreviation; never translated.
msgctxt "dev_col_ttfb"
msgid "TTFB"
msgstr "TTFB"

#. Developer page: table column header for the measurement window.
msgctxt "dev_col_window"
msgid "Window"
msgstr "Dirisha"

#. Developer tools screen (reliability surface): comparative connect control label.
msgctxt "dev_comparative_connect"
msgid "Cut dead connects early"
msgstr "Kata mapema miunganisho iliyokufa"

#. Developer tools screen: explanatory subtext under the 'comparative connect' control.
msgctxt "dev_comparative_connect_detail"
msgid "Drop an exit that has established nothing sooner when two sibling exits are receiving. Off waits the full 30s connect bar"
msgstr "Ondoa mapema njia ya kutoka ambayo haijaanzisha chochote wakati njia mbili za kutoka za kundi moja zinapokea. Kuzima kunasubiri kizingiti kizima cha muunganisho cha sekunde 30"

#. Developer page (Apple): note shown while disconnected.
msgctxt "dev_connect_for_live_tools"
msgid "Connect to use the live connection tools. Diagnostics below work either way."
msgstr "Unganisha ili kutumia zana za muunganisho unaoendelea. Uchunguzi ulio hapa chini hufanya kazi kwa hali zote mbili."

#. Developer page: label of the 'Corroborate silent exits' setting.
msgctxt "dev_corroborate_silent_exits"
msgid "Corroborate silent exits"
msgstr "Thibitisha njia za kutoka zilizo kimya"

#. Developer page: the explanation under the 'Corroborate silent exits' setting.
msgctxt "dev_corroborate_silent_exits_detail"
msgid "How many distinct destinations must be silent before an exit is convicted on no-receive, so one dead site cannot remove a working exit"
msgstr "Idadi ya malengo tofauti yanayopaswa kuwa kimya kabla njia ya kutoka haijahukumiwa kwa kutopokea, ili tovuti moja iliyokufa isiweze kuondoa njia ya kutoka inayofanya kazi"

#. Developer page: suffix after a count of affected flows.
msgctxt "dev_count_affected"
msgid "affected"
msgstr "zilizoathirika"

#. Developer page: label of the 'Cut dead connects early' setting.
msgctxt "dev_cut_dead_connects_early"
msgid "Cut dead connects early"
msgstr "Kata mapema miunganisho iliyokufa"

#. Developer page: the explanation under the 'Cut dead connects early' setting.
msgctxt "dev_cut_dead_connects_early_detail"
msgid "Drop an exit that has established nothing sooner when two sibling exits are receiving, in ms. Off waits the full 30s connect bar"
msgstr "Ondoa mapema njia ya kutoka ambayo haijaanzisha chochote wakati njia mbili za kutoka za kundi moja zinapokea, kwa ms. Kuzima kunasubiri kizingiti kizima cha muunganisho cha sekunde 30"

#. Developer page: report line when the SDK refused an exit action.
msgctxt "dev_declined_exit"
msgid "No change: the SDK declined that exit"
msgstr "Hakuna mabadiliko: SDK ilikataa njia hiyo ya kutoka"

#. Developer page: heading of the destinations table.
msgctxt "dev_destinations"
msgid "Destinations"
msgstr "Malengo"

#. Developer page: explanation under the destinations table.
msgctxt "dev_destinations_detail"
msgid "Which exit each destination's flows are landing on. A site spread over several rows is a site that lost its single egress IP."
msgstr "Njia ya kutoka ambayo mitiririko ya kila lengo inafikia. Tovuti iliyoenea kwenye safu kadhaa ni tovuti iliyopoteza IP yake pekee ya kutokea."

#. Developer page: page title.
msgctxt "dev_developer"
msgid "Developer"
msgstr "Msanidi"

#. Developer tools screen (reliability surface): dial failure rerace control label.
msgctxt "dev_dial_failure_rerace"
msgid "Retry refused connects elsewhere"
msgstr "Jaribu kwingine miunganisho iliyokataliwa"

#. Developer tools screen: explanatory subtext under the 'dial failure rerace' control.
msgctxt "dev_dial_failure_rerace_detail"
msgid "When a provider can't reach a site, move the connection to another exit instead of letting it hang"
msgstr "Mtoa huduma asipoweza kufikia tovuti, hamisha muunganisho kwenda njia nyingine ya kutoka badala ya kuuacha ukining'inia"

#. Developer tools screen (reliability surface): dial failures control label.
msgctxt "dev_dial_failures"
msgid "Provider connect failures"
msgstr "Hitilafu za muunganisho wa watoa huduma"

#. Developer tools screen: explanatory subtext under the 'dial failures' control.
msgctxt "dev_dial_failures_detail"
msgid "Times a provider reported it could not open the upstream connection"
msgstr "Mara ambazo mtoa huduma aliripoti kwamba hakuweza kufungua muunganisho wa kuelekea lengo"

#. Developer tools screen (reliability surface): drop exit control label.
msgctxt "dev_drop_exit"
msgid "Drop"
msgstr "Ondoa"

#. Developer page: label of the 'Drop stalled exits fast' setting.
msgctxt "dev_drop_stalled_exits_fast"
msgid "Drop stalled exits fast"
msgstr "Ondoa haraka njia za kutoka zilizokwama"

#. Developer page: the explanation under the 'Drop stalled exits fast' setting.
msgctxt "dev_drop_stalled_exits_fast_detail"
msgid "How long an exit may stop delivering before it is dropped, in ms. Off waits 30s"
msgstr "Muda ambao njia ya kutoka inaweza kuacha kuwasilisha kabla ya kuondolewa, kwa ms. Kuzima kunasubiri sekunde 30"

#. Developer page: report line after an exit was dropped.
msgctxt "dev_dropped_exit"
msgid "Dropped exit"
msgstr "Njia ya kutoka iliyoondolewa"

#. Developer tools screen (reliability surface): effective tier control label.
msgctxt "dev_effective_tier"
msgid "Live tier demotion"
msgstr "Kushusha daraja papo hapo"

#. Developer tools screen: explanatory subtext under the 'effective tier' control.
msgctxt "dev_effective_tier_detail"
msgid "Failing dials and survived verdicts push a provider down the ranking within a second; promotion back needs clean minutes and a proven connect"
msgstr "Miunganisho iliyoshindwa na hukumu zilizonusurika humshusha mtoa huduma kwenye orodha ndani ya sekunde moja; kupanda tena kunahitaji dakika kadhaa bila hitilafu na muunganisho uliothibitishwa"

#. Developer tools screen (reliability surface): evaluation pool control label.
msgctxt "dev_evaluation_pool"
msgid "Candidates evaluated per slot"
msgstr "Wagombea wanaotathminiwa kwa kila nafasi"

#. Developer tools screen: explanatory subtext under the 'evaluation pool' control.
msgctxt "dev_evaluation_pool_detail"
msgid "How many providers a window expansion pings and ranks per slot it needs, keeping the best. 1 evaluates exactly what it needs"
msgstr "Idadi ya watoa huduma ambao upanuzi wa dirisha huwapigia ping na kuwapanga kwa kila nafasi inayohitajika, ukibakiza walio bora. 1 hutathmini idadi inayohitajika tu"

#. Developer tools screen (reliability surface): exit dial failures control label.
msgctxt "dev_exit_dial_failures"
msgid "{} failed dials"
msgstr "Miunganisho iliyoshindwa: {}"

#. Developer tools screen (reliability surface): exit flows control label.
msgctxt "dev_exit_flows"
msgid "{} flows"
msgstr "Mitiririko: {}"

#. Developer page exit readout: the security policy (safety rules) generation the exit's provider enforces. Connect raises this number with every reviewed change to the built-in rules, so a higher number is newer rules.
msgctxt "dev_exit_policy_generation"
msgid "policy generation {}"
msgstr "kizazi cha sera {}"

#. Developer page exit readout: the exit's provider reported its security policy (safety rules) without a generation, because it predates the generation or runs a custom policy.
msgctxt "dev_exit_policy_generation_unknown"
msgid "policy generation unknown"
msgstr "kizazi cha sera hakijulikani"

#. Developer tools screen (reliability surface): exits control label.
msgctxt "dev_exits"
msgid "Exits"
msgstr "Njia za kutoka"

#. Developer page: explanation of the drop, stall and shuffle actions.
msgctxt "dev_exits_actions_detail"
msgid "Drop, Stall and Shuffle degrade the live connection on purpose, immediately. Nothing here is queued or retried — an action that misses is reported, not replayed."
msgstr "Ondoa, Kwamisha na Changanya hudhoofisha muunganisho unaoendelea kwa makusudi, mara moja. Hakuna kitu hapa kinachowekwa kwenye foleni au kujaribiwa tena — kitendo kinachokosa huripotiwa, hakirudiwi."

#. Developer tools screen: action for exporting all diagnostic logs without redaction.
msgctxt "dev_export_all_logs"
msgid "Export all logs (raw)"
msgstr "Hamisha kumbukumbu zote (ghafi)"

#. Developer tools screen: error shown when diagnostic log export fails.
msgctxt "dev_export_failed"
msgid "Export failed: {}"
msgstr "Uhamishaji umeshindwa: {}"

#. Developer tools screen: explanation that a requested diagnostic item was omitted from an export.
msgctxt "dev_export_not_included"
msgid "Not included: {}"
msgstr "Haijajumuishwa: {}"

#. Developer tools screen: action for exporting diagnostic logs with sensitive traffic details redacted.
msgctxt "dev_export_redacted_logs"
msgid "Export redacted logs"
msgstr "Hamisha kumbukumbu zilizofichwa taarifa"

#. Developer tools screen: action for exporting the selected diagnostic log files.
msgctxt "dev_export_selected"
msgid "Export selected"
msgstr "Hamisha zilizochaguliwa"

#. Developer tools screen: action for sharing a diagnostic bundle.
msgctxt "dev_export_share"
msgid "Share diagnostic bundle"
msgstr "Shiriki kifurushi cha uchunguzi"

#. Developer tools screen: summary of the number and total size of diagnostic log files exported.
msgctxt "dev_export_summary"
msgid "Exported {0} log file ({1})"
msgid_plural "Exported {0} log files ({1})"
msgstr[0] "Faili {0} ya kumbukumbu imehamishwa ({1})"
msgstr[1] "Faili {0} za kumbukumbu zimehamishwa ({1})"

#. Developer tools screen: explanation that a diagnostic export option is unavailable.
msgctxt "dev_export_unavailable"
msgid "Not available: {}"
msgstr "Haipatikani: {}"

#. Developer tools screen: progress label shown while a diagnostic bundle is being exported.
msgctxt "dev_exporting"
msgid "Exporting…"
msgstr "Inahamisha…"

#. Developer page: label of the 'Fast first-exit poll' setting.
msgctxt "dev_fast_first_exit_poll"
msgid "Fast first-exit poll"
msgstr "Ukaguzi wa haraka wa njia ya kwanza ya kutoka"

#. Developer page: the explanation under the 'Fast first-exit poll' setting.
msgctxt "dev_fast_first_exit_poll_detail"
msgid "How often a connecting flow re-checks an empty window, in ms, so the first request leaves right after the first exit lands. Off waits the 2s retry pace"
msgstr "Mara ngapi mtiririko unaounganika hukagua upya dirisha tupu, kwa ms, ili ombi la kwanza liondoke mara tu njia ya kwanza ya kutoka inapofika. Kuzima kunasubiri mwendo wa kujaribu tena wa sekunde 2"

#. Developer tools screen (reliability surface): flows opened control label.
msgctxt "dev_flows_opened"
msgid "Flows opened"
msgstr "Mitiririko iliyofunguliwa"

#. Developer tools screen: explanatory subtext under the 'flows opened' control.
msgctxt "dev_flows_opened_detail"
msgid "Total since reset, so runs of different lengths compare"
msgstr "Jumla tangu kuweka upya, ili uendeshaji wa urefu tofauti ulinganishwe"

#. Developer tools screen (reliability surface): flows rebound control label.
msgctxt "dev_flows_rebound"
msgid "QUIC flows rebound"
msgstr "Mitiririko ya QUIC iliyounganishwa upya"

#. Developer tools screen: explanatory subtext under the 'flows rebound' control.
msgctxt "dev_flows_rebound_detail"
msgid "Flows moved to a warm exit inside a removal; accepted means the server took the path change without a re-dial"
msgstr "Mitiririko iliyohamishiwa njia ya kutoka iliyo tayari wakati wa uondoaji; iliyokubaliwa inamaanisha seva ilikubali mabadiliko ya njia bila kupiga upya"

#. Developer tools screen: formatted value readout for 'flows rebound'.
msgctxt "dev_flows_rebound_value"
msgid "{0} ({1} accepted / {2} re-dialed)"
msgstr "{0} (zilizokubaliwa {1} / zilizopigwa upya {2})"

#. Developer tools screen (reliability surface): flows reraced control label.
msgctxt "dev_flows_reraced"
msgid "Moved to another exit"
msgstr "Zimehamishiwa njia nyingine ya kutoka"

#. Developer tools screen: explanatory subtext under the 'flows reraced' control.
msgctxt "dev_flows_reraced_detail"
msgid "How many of those failures were quietly moved instead of hanging"
msgstr "Ni ngapi kati ya hitilafu hizo zilihamishwa kimyakimya badala ya kukwama"

#. Developer page: label of the 'Follow benched exits' setting.
msgctxt "dev_follow_benched_exits"
msgid "Follow benched exits"
msgstr "Fuata njia za kutoka zilizowekwa benchi"

#. Developer page: the explanation under the 'Follow benched exits' setting.
msgctxt "dev_follow_benched_exits_detail"
msgid "A quarantined exit keeps its own sites' new connections through the early bench, when the verdict is least proven. New sites still avoid it"
msgstr "Njia ya kutoka iliyotengwa huendelea kupokea miunganisho mipya ya tovuti zake mwanzoni mwa kukaa benchi, wakati hukumu bado haijathibitishwa sana. Tovuti mpya bado huiepuka"

#. Developer page: label of the 'Follow window' setting.
msgctxt "dev_follow_window"
msgid "Follow window"
msgstr "Dirisha la kufuata"

#. Developer page: the explanation under the 'Follow window' setting.
msgctxt "dev_follow_window_detail"
msgid "How long into a bench a site's new connections keep following their exit, in ms. Off scatters immediately"
msgstr "Muda ambao miunganisho mipya ya tovuti huendelea kufuata njia yake ya kutoka tangu ianze kukaa benchi, kwa ms. Kuzima kunatawanya mara moja"

#. Developer tools screen (reliability surface): formation poll control label.
msgctxt "dev_formation_poll"
msgid "Fast first-exit poll"
msgstr "Ukaguzi wa haraka wa njia ya kwanza ya kutoka"

#. Developer tools screen: explanatory subtext under the 'formation poll' control.
msgctxt "dev_formation_poll_detail"
msgid "How often a connecting flow re-checks an empty window, so the first request leaves right after the first exit lands. Off waits the 2s retry pace"
msgstr "Mara ngapi mtiririko unaounganika hukagua upya dirisha tupu, ili ombi la kwanza liondoke mara tu njia ya kwanza ya kutoka inapofika. Kuzima kunasubiri mwendo wa kujaribu tena wa sekunde 2"

#. Developer tools screen (reliability surface): hard fresh-flow affinity control label.
msgctxt "dev_fresh_flow_affinity"
msgid "Hard fresh-flow affinity"
msgstr "Mshikamano mkali wa mitiririko mipya"

#. Developer tools screen: explanatory subtext under the hard fresh-flow affinity control.
msgctxt "dev_fresh_flow_affinity_detail"
msgid "Assign each new connection to the exit its IP or domain already uses. Off is the default: every ordinary fresh connection reaches the provider race. Existing connections and explicit pins always stay fixed"
msgstr "Panga kila muunganisho mpya kwenye njia ya kutoka ambayo IP au kikoa chake tayari kinatumia. Chaguomsingi ni kuzimwa: kila muunganisho mpya wa kawaida hufika kwenye mashindano ya watoa huduma. Miunganisho iliyopo na ubanaji uliowekwa wazi hubaki vilevile kila wakati"

#. Developer tools screen (reliability surface): group follow control label.
msgctxt "dev_group_follow"
msgid "Follow benched exits"
msgstr "Fuata njia za kutoka zilizowekwa benchi"

#. Developer tools screen: explanatory subtext under the 'group follow' control.
msgctxt "dev_group_follow_detail"
msgid "A quarantined exit keeps its own sites' new connections through the early bench, when the verdict is least proven, so a bench does not split the site's egress IP. New sites still avoid it. Off scatters them"
msgstr "Njia ya kutoka iliyotengwa huendelea kupokea miunganisho mipya ya tovuti zake mwanzoni mwa kukaa benchi, wakati hukumu bado haijathibitishwa sana, ili benchi lisigawanye IP ya kutokea ya tovuti. Tovuti mpya bado huiepuka. Kuzima kunazitawanya"

#. Developer tools screen (reliability surface): group follow window control label.
msgctxt "dev_group_follow_window"
msgid "Follow window"
msgstr "Dirisha la kufuata"

#. Developer tools screen: explanatory subtext under the 'group follow window' control.
msgctxt "dev_group_follow_window_detail"
msgid "How long into a bench a site's new connections keep following their exit — early benches are usually false alarms; one that lasts is trending toward removal and stops collecting flows. Off scatters immediately"
msgstr "Muda ambao miunganisho mipya ya tovuti huendelea kufuata njia yake ya kutoka tangu ianze kukaa benchi — benchi za mapema mara nyingi ni kengele za uongo; inayodumu huelekea kuondolewa na huacha kupokea mitiririko. Kuzima kunatawanya mara moja"

#. Developer page (Apple): the explanation under the 'Follow window' setting, with its unit.
msgctxt "dev_group_follow_window_ms_detail"
msgid "How long into a bench a site's new connections keep following their exit, in ms — early benches are usually false alarms; one that lasts is trending toward removal and stops collecting flows. Off scatters immediately"
msgstr "Muda ambao miunganisho mipya ya tovuti huendelea kufuata njia yake ya kutoka tangu ianze kukaa benchi, kwa ms — benchi za mapema mara nyingi ni kengele za uongo; inayodumu huelekea kuondolewa na huacha kupokea mitiririko. Kuzima kunatawanya mara moja"

#. Developer tools screen (reliability surface): heartbeat control label.
msgctxt "dev_heartbeat"
msgid "State heartbeat"
msgstr "Mpigo wa hali"

#. Developer tools screen: explanatory subtext under the 'heartbeat' control.
msgctxt "dev_heartbeat_detail"
msgid "How often one line summarizing live state is written to the log for later forensics. Off silences it; shorter spots a transition, longer keeps more buffer"
msgstr "Mara ngapi mstari mmoja unaofupisha hali ya sasa huandikwa kwenye kumbukumbu kwa uchunguzi wa baadaye. Kuzima kunaunyamazisha; muda mfupi hunasa mabadiliko, mrefu huhifadhi bafa zaidi"

#. Developer page (Apple): the explanation under the 'State heartbeat' setting, with its unit.
msgctxt "dev_heartbeat_ms_detail"
msgid "How often one line summarizing live state is written to the log for later forensics, in ms. Off silences it; shorter spots a transition, longer keeps more buffer"
msgstr "Mara ngapi mstari mmoja unaofupisha hali ya sasa huandikwa kwenye kumbukumbu kwa uchunguzi wa baadaye, kwa ms. Kuzima kunaunyamazisha; muda mfupi hunasa mabadiliko, mrefu huhifadhi bafa zaidi"

#. Developer page: intro line under the title.
msgctxt "dev_intro"
msgid "Tools for diagnosing connection freezes. These act on the live connection."
msgstr "Zana za kuchunguza miunganisho inayokwama. Zinafanya kazi kwenye muunganisho unaotumika."

#. Developer screen: title of the control-plane IP family setting.
msgctxt "dev_ip_family"
msgid "Control connections"
msgstr "Miunganisho ya udhibiti"

#. Developer screen: the automatic IP family option.
msgctxt "dev_ip_family_auto"
msgid "Automatic"
msgstr "Kiotomatiki"

#. Developer screen: the automatic option's detail when one family was demoted; {reason} is the demotion reason.
msgctxt "dev_ip_family_auto_demoted_detail"
msgid "Automatic. {}."
msgstr "Kiotomatiki. {}."

#. Developer screen: detail line of the automatic IP family option.
msgctxt "dev_ip_family_auto_detail"
msgid "Uses whichever family connects first, and routes around one that fails after connecting."
msgstr "Hutumia familia ya anwani inayounganika kwanza, na huepuka ile inayoshindwa baada ya kuunganika."

#. Developer screen: the IPv4-only option.
msgctxt "dev_ip_family_force4"
msgid "Force IPv4"
msgstr "Lazimisha IPv4"

#. Developer screen: detail line of the IPv4-only option.
msgctxt "dev_ip_family_force4_detail"
msgid "Control-plane connections use IPv4 only. Turn this off on an IPv6-only network."
msgstr "Miunganisho ya udhibiti hutumia IPv4 pekee. Zima hii kwenye mtandao wa IPv6 pekee."

#. Developer screen: the IPv6-only option.
msgctxt "dev_ip_family_force6"
msgid "Force IPv6"
msgstr "Lazimisha IPv6"

#. Developer screen: detail line of the IPv6-only option.
msgctxt "dev_ip_family_force6_detail"
msgid "Control-plane connections use IPv6 only. Turn this off if the app cannot reach the server."
msgstr "Miunganisho ya udhibiti hutumia IPv6 pekee. Zima hii ikiwa programu haiwezi kufikia seva."

#. Developer page: label of the 'Keep quiet providers longer' setting.
msgctxt "dev_keep_quiet_providers_longer"
msgid "Keep quiet providers longer"
msgstr "Weka watoa huduma walio kimya kwa muda mrefu zaidi"

#. Developer page: the explanation under the 'Keep quiet providers longer' setting.
msgctxt "dev_keep_quiet_providers_longer_detail"
msgid "How long a provider still acknowledging traffic may return nothing before it is dropped, in ms. Off keeps them until they stop acknowledging"
msgstr "Muda ambao mtoa huduma ambaye bado anathibitisha trafiki anaweza kukaa bila kurudisha chochote kabla ya kuondolewa, kwa ms. Kuzima kunawaweka hadi watakapoacha kuthibitisha"

#. Developer tools screen (reliability surface): load corroboration control label.
msgctxt "dev_load_corroboration"
msgid "Load corroboration"
msgstr "Uthibitisho kwa mzigo"

#. Developer tools screen: explanatory subtext under the 'load corroboration' control.
msgctxt "dev_load_corroboration_detail"
msgid "Extra silent destinations required per this many flows before a busy exit can be benched on soft evidence: a 24-flow exit at 8 needs 3 silent sites, not 2. Off keeps the flat minimum"
msgstr "Malengo ya ziada yaliyo kimya yanayohitajika kwa kila idadi hii ya mitiririko kabla njia ya kutoka yenye shughuli haijawekwa benchi kwa ushahidi dhaifu: njia yenye mitiririko 24 kwa thamani 8 inahitaji tovuti 3 zilizo kimya, si 2. Kuzima kunabakiza kiwango cha chini kisichobadilika"

#. Developer tools screen: control label for diagnostic log detail.
msgctxt "dev_log_verbosity"
msgid "Log detail"
msgstr "Undani wa kumbukumbu"

#. Developer tools screen: default diagnostic log detail level.
msgctxt "dev_log_verbosity_default"
msgid "Default"
msgstr "Chaguomsingi"

#. Developer tools screen: explanation of the default diagnostic log detail level.
msgctxt "dev_log_verbosity_default_detail"
msgid "Connection errors and contract pings"
msgstr "Hitilafu za muunganisho na ping za mikataba"

#. Developer tools screen: trace diagnostic log detail level.
msgctxt "dev_log_verbosity_trace"
msgid "Trace"
msgstr "Ufuatiliaji"

#. Developer tools screen: explanation of the trace diagnostic log detail level.
msgctxt "dev_log_verbosity_trace_detail"
msgid "Transport and window internals. Very large logs"
msgstr "Maelezo ya ndani ya usafirishaji na dirisha. Kumbukumbu kubwa sana"

#. Developer tools screen: label used when the diagnostic log detail level cannot be read.
msgctxt "dev_log_verbosity_unavailable"
msgid "Unavailable"
msgstr "Haipatikani"

#. Developer tools screen: explanation shown when the diagnostic log detail level cannot be read.
msgctxt "dev_log_verbosity_unavailable_detail"
msgid "There is no device to read the log level from yet. Sign in first"
msgstr "Bado hakuna kifaa cha kusoma kiwango cha kumbukumbu. Ingia kwanza"

#. Developer tools screen: verbose diagnostic log detail level.
msgctxt "dev_log_verbosity_verbose"
msgid "Verbose"
msgstr "Kwa kina"

#. Developer tools screen: explanation of the verbose diagnostic log detail level.
msgctxt "dev_log_verbosity_verbose_detail"
msgid "Contract accounting and per-packet block decisions. Includes destination IP addresses"
msgstr "Uhasibu wa mikataba na maamuzi ya kuzuia kwa kila pakiti. Inajumuisha anwani za IP za malengo"

#. Developer tools screen: privacy warning shown when detailed traffic logging is enabled.
msgctxt "dev_log_verbosity_warning"
msgid "At Verbose and above the logs contain the destination IP addresses and ports of the traffic you send. Use “Export redacted logs” to share them; the raw bundle should not leave this device."
msgstr "Kuanzia kiwango cha Kwa kina na zaidi, kumbukumbu zina anwani za IP na milango ya malengo ya trafiki unayotuma. Tumia \"Hamisha kumbukumbu zilizofichwa taarifa\" ili kuzishiriki; kifurushi ghafi hakipaswi kutoka kwenye kifaa hiki."

#. Developer tools screen: title for the detailed traffic logging privacy warning.
msgctxt "dev_log_verbosity_warning_title"
msgid "Logs are recording your real traffic"
msgstr "Kumbukumbu zinarekodi trafiki yako halisi"

#. Developer page: label of the 'Longer TCP idle timeout' setting.
msgctxt "dev_longer_tcp_idle_timeout"
msgid "Longer TCP idle timeout"
msgstr "Muda mrefu zaidi wa kutotumika wa TCP"

#. Developer page: the explanation under the 'Longer TCP idle timeout' setting.
msgctxt "dev_longer_tcp_idle_timeout_detail"
msgid "How long a TCP connection may sit idle, in ms. Off uses the UDP bound"
msgstr "Muda ambao muunganisho wa TCP unaweza kukaa bila kutumika, kwa ms. Kuzima kunatumia kikomo cha UDP"

#. Developer tools screen (reliability surface): max flows per exit control label.
msgctxt "dev_max_flows_per_exit"
msgid "Max connections per exit"
msgstr "Upeo wa miunganisho kwa kila njia ya kutoka"

#. Developer tools screen: explanatory subtext under the 'max flows per exit' control.
msgctxt "dev_max_flows_per_exit_detail"
msgid "Losing an exit kills every connection on it. Lower spreads the damage; a site may then use more than one exit IP"
msgstr "Kupoteza njia ya kutoka kunaua kila muunganisho ulio juu yake. Thamani ndogo hutawanya madhara; kisha tovuti inaweza kutumia zaidi ya IP moja ya kutokea"

#. Developer tools screen (reliability surface): measure none control label.
msgctxt "dev_measure_none"
msgid "No provider failures yet. Stall an exit below to cause one."
msgstr "Bado hakuna hitilafu za watoa huduma. Kwamisha njia ya kutoka hapa chini ili kusababisha moja."

#. Developer tools screen (reliability surface): measurements control label.
msgctxt "dev_measurements"
msgid "Measurements"
msgstr "Vipimo"

#. Developer tools screen: explanatory subtext under the 'measurements' control.
msgctxt "dev_measurements_detail"
msgid "What a provider failure costs. Reset, run a test, read back."
msgstr "Hitilafu ya mtoa huduma inagharimu nini. Weka upya, endesha jaribio, soma matokeo."

#. Developer page: button that migrates the live connection.
msgctxt "dev_migrate"
msgid "Migrate"
msgstr "Hamisha"

#. Developer tools screen (reliability surface): migrate exit control label.
msgctxt "dev_migrate_exit"
msgid "Migrate"
msgstr "Hamisha"

#. Developer page: last-action report after moving an exit's flows to another exit; the exit's short id follows.
msgctxt "dev_migrated_exit"
msgid "Migrated exit"
msgstr "Njia ya kutoka iliyohamishwa"

#. Developer tools screen (reliability surface): min blackhole destinations control label.
msgctxt "dev_min_blackhole_destinations"
msgid "Corroborate silent exits"
msgstr "Thibitisha njia za kutoka zilizo kimya"

#. Developer tools screen: explanatory subtext under the 'min blackhole destinations' control.
msgctxt "dev_min_blackhole_destinations_detail"
msgid "How many distinct destinations must be silent before an exit is convicted on no-receive, so one dead site cannot remove a working exit. Off lets a single destination convict"
msgstr "Idadi ya malengo tofauti yanayopaswa kuwa kimya kabla njia ya kutoka haijahukumiwa kwa kutopokea, ili tovuti moja iliyokufa isiweze kuondoa njia ya kutoka inayofanya kazi. Kuzima kunaruhusu lengo moja kuhukumu"

#. Developer page: value of the flows that never came back, {done} of {total}.
msgctxt "dev_never_came_back_value"
msgid "{0} of {1}"
msgstr "{0} kati ya {1}"

#. Developer page: empty state of the destinations table.
msgctxt "dev_no_destinations"
msgid "No destinations yet."
msgstr "Bado hakuna malengo."

#. Developer page: shown when there is no session to act on.
msgctxt "dev_no_device"
msgid "No session. Sign in and connect to use these tools."
msgstr "Hakuna kipindi. Ingia na uunganishe ili kutumia zana hizi."

#. Developer tools screen (reliability surface): no exits control label.
msgctxt "dev_no_exits"
msgid "No exits. Connect first."
msgstr "Hakuna njia za kutoka. Unganisha kwanza."

#. Developer page: empty state of the probe results table.
msgctxt "dev_no_probe_results"
msgid "No probe results yet. Start the suite."
msgstr "Bado hakuna matokeo ya vipimo. Anzisha seti."

#. Developer page: empty state of the provider failures table.
msgctxt "dev_no_provider_failures"
msgid "No provider failures yet."
msgstr "Bado hakuna hitilafu za watoa huduma."

#. Developer page: report line when no reliability override is in force.
msgctxt "dev_not_applied"
msgid "Not applied: there is no reliability override in force to change."
msgstr "Haijatumika: hakuna ubatilishaji wa uaminifu unaotumika wa kubadilisha."

#. Developer page: report line when there is no live session to act on.
msgctxt "dev_not_issued"
msgid "Not issued: there is no live session to act on."
msgstr "Haijatumwa: hakuna kipindi kinachoendelea cha kushughulikia."

#. Developer page: note shown when no reliability override is in force.
msgctxt "dev_nothing_in_force"
msgid "No reliability override is in force, so the settings sections are hidden rather than shown at zero. The measurements and exit readout below are live."
msgstr "Hakuna ubatilishaji wa uaminifu unaotumika, kwa hiyo sehemu za mipangilio zimefichwa badala ya kuonyeshwa kwa sifuri. Vipimo na usomaji wa njia za kutoka hapa chini ni hai."

#. Developer page: what a setting's 0 means when it falls back to the minimum of 1 ('Candidates evaluated per slot').
msgctxt "dev_one_min"
msgid "1 (min)"
msgstr "1 (kiwango cha chini)"

#. Developer tools screen (reliability surface): open tools control label.
msgctxt "dev_open_tools"
msgid "Open developer tools"
msgstr "Fungua zana za wasanidi"

#. Developer tools screen (reliability surface): probe all control label.
msgctxt "dev_probe_all"
msgid "Probe all exits now"
msgstr "Pima njia zote za kutoka sasa"

#. Developer page: button that probes every exit now.
msgctxt "dev_probe_all_exits_now"
msgid "Probe all exits now"
msgstr "Pima njia zote za kutoka sasa"

#. Developer page: probe outcome, failed.
msgctxt "dev_probe_failed"
msgid "failed"
msgstr "imeshindwa"

#. Developer page: probe outcome, ok.
msgctxt "dev_probe_ok"
msgid "ok"
msgstr "sawa"

#. Developer tools screen (reliability surface): probe providers control label.
msgctxt "dev_probe_providers"
msgid "Probe providers"
msgstr "Pima watoa huduma"

#. Developer tools screen: explanatory subtext under the 'probe providers' control.
msgctxt "dev_probe_providers_detail"
msgid "Qualify exits by dialing real sites through them. An answer proves the exit; silence never counts against it"
msgstr "Thibitisha njia za kutoka kwa kupiga tovuti halisi kupitia njia hizo. Jibu huthibitisha njia ya kutoka; ukimya hauhesabiwi dhidi yake kamwe"

#. Developer tools screen (reliability surface): probe sample hosts control label.
msgctxt "dev_probe_sample_hosts"
msgid "Probe hosts per pass"
msgstr "Seva za kupima kwa kila mzunguko"

#. Developer tools screen: explanatory subtext under the 'probe sample hosts' control.
msgctxt "dev_probe_sample_hosts_detail"
msgid "How many health sites one qualification pass dials through an exit. 0 probes the entire embedded list; a smaller number rotates through it in blocks"
msgstr "Idadi ya tovuti za ukaguzi ambazo mzunguko mmoja wa uthibitisho hupiga kupitia njia ya kutoka. 0 hupima orodha yote iliyojengewa ndani; idadi ndogo huipitia kwa vipande"

#. Developer page: label of the 'Probe silence streak' setting.
msgctxt "dev_probe_silence_streak"
msgid "Probe silence streak"
msgstr "Mfululizo wa vipimo visivyojibiwa"

#. Developer page: the explanation under the 'Probe silence streak' setting.
msgctxt "dev_probe_silence_streak_detail"
msgid "How many consecutive probe passes an exit may answer with total silence before it is warned out of new-flow placement. Placement only"
msgstr "Idadi ya mizunguko ya vipimo mfululizo ambayo njia ya kutoka inaweza kujibu kwa ukimya kamili kabla ya kuonywa na kuondolewa kwenye upangaji wa mitiririko mipya. Upangaji pekee"

#. Developer page (Apple): the explanation under the 'Probe silence streak' setting.
msgctxt "dev_probe_silence_streak_long_detail"
msgid "How many consecutive probe passes an exit may answer with total silence before it is warned out of new-flow placement — the compensation for providers that leave the network mid-session. Placement only: removal stays traffic-based, and any sign of life clears the streak"
msgstr "Idadi ya mizunguko ya vipimo mfululizo ambayo njia ya kutoka inaweza kujibu kwa ukimya kamili kabla ya kuonywa na kuondolewa kwenye upangaji wa mitiririko mipya — fidia kwa watoa huduma wanaoondoka kwenye mtandao katikati ya kipindi. Upangaji pekee: uondoaji bado unategemea trafiki, na dalili yoyote ya uhai hufuta mfululizo"

#. Developer page: label of the 'Probe stalled exits before dropping' setting.
msgctxt "dev_probe_stalled_exits"
msgid "Probe stalled exits before dropping"
msgstr "Pima njia za kutoka zilizokwama kabla ya kuziondoa"

#. Developer page: the explanation under the 'Probe stalled exits before dropping' setting.
msgctxt "dev_probe_stalled_exits_detail"
msgid "When an exit stalls, ping it once before convicting. A congested but alive exit answers and keeps its flows; a dead one is still dropped"
msgstr "Njia ya kutoka inapokwama, inapigiwa ping mara moja kabla ya kuhukumiwa. Njia yenye msongamano lakini iliyo hai hujibu na kubaki na mitiririko yake; iliyokufa huondolewa vilevile"

#. Developer page: heading of the probe suite section.
msgctxt "dev_probe_suite"
msgid "Probe suite"
msgstr "Seti ya vipimo"

#. Developer page: explanation of the probe suite.
msgctxt "dev_probe_suite_detail"
msgid "Dials real targets through the live connection and times each stage. Runs with the SDK's own default configuration."
msgstr "Hupiga malengo halisi kupitia muunganisho unaoendelea na hupima muda wa kila hatua. Huendeshwa kwa usanidi chaguomsingi wa SDK yenyewe."

#. Developer page: probe suite status when it is not running.
msgctxt "dev_probe_suite_idle"
msgid "Not running."
msgstr "Haiendeshwi."

#. Developer page: report line when the probe suite could not start.
msgctxt "dev_probe_suite_not_started"
msgid "Probe suite did not start: no live session, or one is already running."
msgstr "Seti ya vipimo haikuanza: hakuna kipindi kinachoendelea, au moja tayari inaendeshwa."

#. Developer page: probe suite status while it runs.
msgctxt "dev_probe_suite_running"
msgid "Running."
msgstr "Inaendeshwa."

#. Developer page: button that starts the probe suite.
msgctxt "dev_probe_suite_start"
msgid "Start probe suite"
msgstr "Anzisha seti ya vipimo"

#. Developer page: report line after the probe suite started.
msgctxt "dev_probe_suite_started"
msgid "Probe suite started"
msgstr "Seti ya vipimo imeanzishwa"

#. Developer page: button that stops the probe suite.
msgctxt "dev_probe_suite_stop"
msgid "Stop"
msgstr "Simamisha"

#. Developer page: report line after the probe suite stopped.
msgctxt "dev_probe_suite_stopped"
msgid "Probe suite stopped"
msgstr "Seti ya vipimo imesimamishwa"

#. Developer tools screen (reliability surface): probe timeout control label.
msgctxt "dev_probe_timeout"
msgid "Probe wait"
msgstr "Muda wa kusubiri wa kipimo"

#. Developer tools screen: explanatory subtext under the 'probe timeout' control.
msgctxt "dev_probe_timeout_detail"
msgid "How long a qualification probe waits for an answer. Off uses the built-in 4s. It only bounds waiting for proof, it never convicts"
msgstr "Muda ambao kipimo cha uthibitisho husubiri jibu. Kuzima kunatumia sekunde 4 zilizojengewa ndani. Hupunguza tu muda wa kusubiri uthibitisho, haihukumu kamwe"

#. Developer page: label of the 'Probe wait' setting.
msgctxt "dev_probe_wait"
msgid "Probe wait"
msgstr "Muda wa kusubiri wa kipimo"

#. Developer page: the explanation under the 'Probe wait' setting.
msgctxt "dev_probe_wait_detail"
msgid "How long a qualification probe waits for an answer, in ms. Off uses the built-in 4s. It only bounds waiting for proof, it never convicts"
msgstr "Muda ambao kipimo cha uthibitisho husubiri jibu, kwa ms. Kuzima kunatumia sekunde 4 zilizojengewa ndani. Hupunguza tu muda wa kusubiri uthibitisho, haihukumu kamwe"

#. Developer page: heading of the probed exits table.
msgctxt "dev_probed_exits"
msgid "Probed exits"
msgstr "Njia za kutoka zilizopimwa"

#. Developer tools screen (reliability surface): probes control label.
msgctxt "dev_probes"
msgid "Probes"
msgstr "Vipimo"

#. Developer tools screen: explanatory subtext under the 'probes' control.
msgctxt "dev_probes_detail"
msgid "Qualification probes this session"
msgstr "Vipimo vya uthibitisho katika kipindi hiki cha matumizi"

#. Developer tools screen: formatted value readout for 'probes'.
msgctxt "dev_probes_value"
msgid "{0} sent / {1} answered"
msgstr "Vilivyotumwa {0} / vilivyojibiwa {1}"

#. Developer page: value of the QUIC flows that rebound: {count} total, {accepted} accepted, {redialed} re-dialed.
msgctxt "dev_quic_flows_rebound_value"
msgid "{0} ({1} accepted / {2} re-dialed)"
msgstr "{0} (zilizokubaliwa {1} / zilizopigwa upya {2})"

#. Developer tools screen (reliability surface): quic rebind control label.
msgctxt "dev_quic_rebind"
msgid "Rebind QUIC on exit loss"
msgstr "Unganisha QUIC upya njia ya kutoka ikipotea"

#. Developer tools screen: explanatory subtext under the 'quic rebind' control.
msgctxt "dev_quic_rebind_detail"
msgid "Re-pin established QUIC flows to a live exit inside the removal instead of tearing them down"
msgstr "Bana upya mitiririko ya QUIC iliyoanzishwa kwenye njia ya kutoka iliyo hai wakati wa uondoaji badala ya kuivunja"

#. Developer tools screen (reliability surface): recovery control label.
msgctxt "dev_recovery"
msgid "Recovery time"
msgstr "Muda wa kurejea"

#. Developer tools screen: explanatory subtext under the 'recovery' control.
msgctxt "dev_recovery_detail"
msgid "From an exit dying to that site answering again"
msgstr "Kuanzia njia ya kutoka inapokufa hadi tovuti hiyo inapojibu tena"

#. Developer tools screen (reliability surface): recovery missed control label.
msgctxt "dev_recovery_missed"
msgid "Never came back"
msgstr "Hazikurejea kamwe"

#. Developer tools screen: explanatory subtext under the 'recovery missed' control.
msgctxt "dev_recovery_missed_detail"
msgid "Sites abandoned rather than recovered"
msgstr "Tovuti zilizoachwa badala ya kurejeshwa"

#. Developer tools screen: formatted value readout for 'recovery missed'.
msgctxt "dev_recovery_missed_value"
msgid "{0} of {1}"
msgstr "{0} kati ya {1}"

#. Developer page: value of the recovery time, {average} and {worst} are durations.
msgctxt "dev_recovery_time_value"
msgid "avg {0}, worst {1}"
msgstr "wastani {0}, mbaya zaidi {1}"

#. Developer tools screen: formatted value readout for 'recovery'.
msgctxt "dev_recovery_value"
msgid "avg {0}, worst {1}"
msgstr "wastani {0}, mbaya zaidi {1}"

#. Developer tools screen (reliability surface): refresh control label.
msgctxt "dev_refresh"
msgid "Refresh"
msgstr "Onyesha upya"

#. Developer page: label of the 'Release stuck retransmits' setting.
msgctxt "dev_release_stuck_retransmits"
msgid "Release stuck retransmits"
msgstr "Achilia utumaji upya uliokwama"

#. Developer page: the explanation under the 'Release stuck retransmits' setting.
msgctxt "dev_release_stuck_retransmits_detail"
msgid "How long retransmits are held before one is released, in ms. Off waits 30s"
msgstr "Muda ambao utumaji upya huzuiliwa kabla ya mmoja kuachiliwa, kwa ms. Kuzima kunasubiri sekunde 30"

#. Developer tools screen (reliability surface): removal budget count control label.
msgctxt "dev_removal_budget_count"
msgid "Removal storm limit"
msgstr "Kikomo cha dhoruba ya uondoaji"

#. Developer tools screen: explanatory subtext under the 'removal budget count' control.
msgctxt "dev_removal_budget_count_detail"
msgid "How many verdict removals are allowed per window before the rest are deferred; a burst is more likely one local cause than many failures. Off removes without limit"
msgstr "Idadi ya uondoaji wa kihukumu unaoruhusiwa kwa kila dirisha kabla ya mengine kuahirishwa; mlipuko una uwezekano mkubwa wa kuwa na chanzo kimoja cha ndani kuliko hitilafu nyingi. Kuzima kunaondoa bila kikomo"

#. Developer tools screen (reliability surface): removal budget window control label.
msgctxt "dev_removal_budget_window"
msgid "Removal storm window"
msgstr "Dirisha la dhoruba ya uondoaji"

#. Developer tools screen: explanatory subtext under the 'removal budget window' control.
msgctxt "dev_removal_budget_window_detail"
msgid "The window the removal limit is counted over. Off (like a limit of 0) turns the breaker off"
msgstr "Dirisha ambamo kikomo cha uondoaji kinahesabiwa. Kuzima (sawa na kikomo cha 0) kunazima kikatizi"

#. Developer page: label of the 'Removal storm limit' setting.
msgctxt "dev_removal_storm_limit"
msgid "Removal storm limit"
msgstr "Kikomo cha dhoruba ya uondoaji"

#. Developer page: the explanation under the 'Removal storm limit' setting.
msgctxt "dev_removal_storm_limit_detail"
msgid "How many verdict removals are allowed per window before the rest are deferred; a burst is more likely one local cause than many failures"
msgstr "Idadi ya uondoaji wa kihukumu unaoruhusiwa kwa kila dirisha kabla ya mengine kuahirishwa; mlipuko una uwezekano mkubwa wa kuwa na chanzo kimoja cha ndani kuliko hitilafu nyingi"

#. Developer page: label of the 'Removal storm window' setting.
msgctxt "dev_removal_storm_window"
msgid "Removal storm window"
msgstr "Dirisha la dhoruba ya uondoaji"

#. Developer page: the explanation under the 'Removal storm window' setting.
msgctxt "dev_removal_storm_window_detail"
msgid "The window the removal limit is counted over, in ms. Off (like a limit of 0) turns the breaker off"
msgstr "Dirisha ambamo kikomo cha uondoaji kinahesabiwa, kwa ms. Kuzima (sawa na kikomo cha 0) kunazima kikatizi"

#. Developer tools screen (reliability surface): removals deferred control label.
msgctxt "dev_removals_deferred"
msgid "Removals deferred"
msgstr "Uondoaji ulioahirishwa"

#. Developer tools screen: explanatory subtext under the 'removals deferred' control.
msgctxt "dev_removals_deferred_detail"
msgid "Removals the storm breaker held back after a correlated burst"
msgstr "Uondoaji ambao kikatizi cha dhoruba kilizuia baada ya mlipuko unaohusiana"

#. Developer page: label before the requested value of an override.
msgctxt "dev_requested"
msgid "Requested:"
msgstr "Imeombwa:"

#. Developer tools screen (reliability surface): reset defaults control label.
msgctxt "dev_reset_defaults"
msgid "Reset to shipped defaults"
msgstr "Rejesha chaguomsingi za awali"

#. Developer tools screen (reliability surface): reset measurements control label.
msgctxt "dev_reset_measurements"
msgid "Reset measurements"
msgstr "Weka upya vipimo"

#. Developer page: button that resets the reliability settings.
msgctxt "dev_reset_to_shipped_defaults"
msgid "Reset to shipped defaults"
msgstr "Rejesha chaguomsingi za awali"

#. Developer tools screen (reliability surface): scheduler pause recovery control label.
msgctxt "dev_scheduler_pause_recovery"
msgid "Suspend recovery window"
msgstr "Dirisha la kurejea baada ya usingizi"

#. Developer tools screen: explanatory subtext under the 'scheduler pause recovery' control.
msgctxt "dev_scheduler_pause_recovery_detail"
msgid "How long verdicts stay held after a detected suspend, giving transports time to re-register. Off uses the built-in 5s"
msgstr "Muda ambao hukumu huzuiliwa baada ya usingizi kugunduliwa, ili usafirishaji upate muda wa kujisajili upya. Kuzima kunatumia sekunde 5 zilizojengewa ndani"

#. Developer tools screen (reliability surface): scheduler pause tolerance control label.
msgctxt "dev_scheduler_pause_tolerance"
msgid "Suspend detector"
msgstr "Kigunduzi cha usingizi"

#. Developer tools screen: explanatory subtext under the 'scheduler pause tolerance' control.
msgctxt "dev_scheduler_pause_tolerance_detail"
msgid "How much timer overshoot reads as the phone being suspended rather than an exit stalling, so a resumed phone does not convict every exit at once. Off disables it"
msgstr "Kiasi cha kuchelewa kwa kipima muda kinachotafsiriwa kama simu iliyolala badala ya njia ya kutoka iliyokwama, ili simu iliyoamka isihukumu njia zote za kutoka kwa wakati mmoja. Kuzima kunakizima"

#. Developer page (Apple): the explanation under the 'Suspend detector' setting, with its unit.
msgctxt "dev_scheduler_pause_tolerance_ms_detail"
msgid "How much timer overshoot reads as the phone being suspended rather than an exit stalling, in ms, so a resumed phone does not convict every exit at once. Off disables it"
msgstr "Kiasi cha kuchelewa kwa kipima muda, kwa ms, kinachotafsiriwa kama simu iliyolala badala ya njia ya kutoka iliyokwama, ili simu iliyoamka isihukumu njia zote za kutoka kwa wakati mmoja. Kuzima kunakizima"

#. Developer tools screen (reliability surface): scheduler pauses control label.
msgctxt "dev_scheduler_pauses"
msgid "Suspends caught"
msgstr "Usingizi uliogunduliwa"

#. Developer tools screen: explanatory subtext under the 'scheduler pauses' control.
msgctxt "dev_scheduler_pauses_detail"
msgid "Host suspends the detector caught, each one a batch of verdicts held instead of executed on a just-resumed phone"
msgstr "Usingizi wa mwenyeji uliogunduliwa na kigunduzi, kila mmoja ukiwa kundi la hukumu zilizozuiliwa badala ya kutekelezwa kwenye simu iliyoamka hivi punde"

#. Developer tools screen: section heading for the detection controls.
msgctxt "dev_section_detection"
msgid "Detection"
msgstr "Ugunduzi"

#. Developer tools screen: section heading for diagnostic log controls.
msgctxt "dev_section_diagnostics"
msgid "Diagnostics"
msgstr "Uchunguzi"

#. Developer tools screen: section heading for the observability controls.
msgctxt "dev_section_observability"
msgid "Observability"
msgstr "Uonekanaji"

#. Developer tools screen: section heading for the placement controls.
msgctxt "dev_section_placement"
msgid "Placement"
msgstr "Upangaji"

#. Developer tools screen: section heading for the probing controls.
msgctxt "dev_section_probing"
msgid "Probing"
msgstr "Upimaji"

#. Developer tools screen: section heading for the recovery controls.
msgctxt "dev_section_recovery"
msgid "Recovery"
msgstr "Urejeshaji"

#. Developer tools screen (reliability surface): send stall control label.
msgctxt "dev_send_stall"
msgid "Drop stalled exits fast"
msgstr "Ondoa haraka njia za kutoka zilizokwama"

#. Developer tools screen: explanatory subtext under the 'send stall' control.
msgctxt "dev_send_stall_detail"
msgid "How long an exit may stop delivering before it is dropped. Off waits 30s"
msgstr "Muda ambao njia ya kutoka inaweza kuacha kuwasilisha kabla ya kuondolewa. Kuzima kunasubiri sekunde 30"

#. Developer tools screen (reliability surface): server name bridge control label.
msgctxt "dev_server_name_bridge"
msgid "Converge late-named flows"
msgstr "Unganisha mitiririko iliyopata jina kwa kuchelewa"

#. Developer tools screen: explanatory subtext under the 'server name bridge' control.
msgctxt "dev_server_name_bridge_detail"
msgid "Moves later connections onto the exit the first one already uses"
msgstr "Huhamisha miunganisho inayofuata kwenda njia ya kutoka ambayo wa kwanza tayari unatumia"

#. Developer page: shown when the system service is not attached.
msgctxt "dev_service_detached"
msgid "The URnetwork service is not attached, so the live connection cannot be read."
msgstr "Huduma ya URnetwork haijaunganishwa, kwa hiyo muunganisho unaoendelea hauwezi kusomwa."

#. Developer page: heading of the daemon session log.
msgctxt "dev_session_log"
msgid "Session log"
msgstr "Kumbukumbu ya kipindi"

#. Developer page: shown when this account may not read the daemon log.
msgctxt "dev_session_log_denied"
msgid "This account may drive the daemon but may not read its log."
msgstr "Akaunti hii inaweza kuendesha huduma lakini haiwezi kusoma kumbukumbu yake."

#. Developer page: explanation of the session log.
msgctxt "dev_session_log_detail"
msgid "What the daemon has written since it started. The reliability lines ([rel] event=...) are how a knob below proves it changed something."
msgstr "Kile ambacho huduma imeandika tangu ilipoanza. Mistari ya uaminifu ([rel] event=...) ndiyo inayothibitisha kwamba mpangilio ulio hapa chini umebadilisha kitu."

#. Developer page: line in the session log when {count} earlier lines were dropped.
