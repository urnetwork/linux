msgid "A friend has joined — you're earning +{1} GiB/day, for life."
msgid_plural "{0} friends have joined — you're earning +{1} GiB/day, for life."
msgstr[0] "{0} người bạn đã tham gia — bạn đang nhận +{1} GiB/ngày, trọn đời."

#. Call to action
msgctxt "referral_network"
msgid "Referral network"
msgstr "Mạng giới thiệu"

#. Snackbar on the Referrals screen after the referral network was changed.
msgctxt "referral_network_updated"
msgid "Referral network updated"
msgstr "Đã cập nhật mạng giới thiệu"

#. Detail line of the gold referral panel. The amount is the daily GiB each side earns per verified referral (pro.yml referral).
msgctxt "referral_panel_detail"
msgid "Every verified referral gives each of you {} GiB/day for free, for life."
msgstr "Mỗi lượt giới thiệu đã xác minh mang lại cho cả hai bạn {} GiB/ngày miễn phí, trọn đời."

#. Heading of the gold referral panel (the ur.io referral panel) before the network has a referral.
msgctxt "referral_panel_heading"
msgid "Refer a friend and you both get free data"
msgstr "Giới thiệu bạn bè và cả hai cùng nhận dữ liệu miễn phí"

#. Status line of the gold referral panel while the network has no referral yet.
msgctxt "referral_panel_none"
msgid "No friends yet. Share your code and watch the crown appear. 👑"
msgstr "Chưa có bạn bè nào. Chia sẻ mã của bạn và xem vương miện xuất hiện. 👑"

#. Referrals screen: label of the points a network earned from its referrals (the payout_linked_account points), shown next to the total referral count.
msgctxt "referral_points"
msgid "Referral points"
msgstr "Điểm giới thiệu"

#. A label displaying the number of referrals a user has made. The argument is the number of referrals.
msgctxt "referral_progress_of_five"
msgid "{}/5"
msgstr "{}/5"

#. Celebration headline shown the moment a referral code is accepted (signup bonus sheet and the settings referral sheet). Royal king-frog theme, matches the ur.io referral panel.
msgctxt "referral_royal_welcome"
msgid "A royal welcome!"
msgstr "Chào đón hoàng gia!"

#. Detail line under the royal-welcome headline when a referral code is accepted. {data} is the daily bonus in GiB each side earns (pro.yml referral, currently 3).
msgctxt "referral_royal_welcome_detail"
msgid "Referral confirmed — you and your friend each get +{} GiB/day of free data, for life."
msgstr "Đã xác nhận giới thiệu — bạn và bạn bè của bạn mỗi người nhận +{} GiB/ngày dữ liệu miễn phí, trọn đời."

