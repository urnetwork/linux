msgctxt "dev_tcp_collapse_hold_detail"
msgid "How long retransmits are held before one is released. Off waits 30s"
msgstr "Các gói truyền lại bị giữ bao lâu trước khi một gói được giải phóng. Tắt sẽ chờ 30 giây"

