msgctxt "adv_providers_load_failed"
msgid "Could not load the provider list."
msgstr "Die Anbieterliste konnte nicht geladen werden."

#. Connection inspector (Linux) and Advanced Mode status strip (Windows): label of the raw status field.
msgctxt "adv_raw_status"
msgid "Raw status"
msgstr "Rohstatus"

#. Connection inspector: label of the decision reason row.
msgctxt "adv_reason"
msgid "Reason"
