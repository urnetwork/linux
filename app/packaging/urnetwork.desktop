[Desktop Entry]
Type=Application
Name=URnetwork
Comment=URnetwork VPN
Icon=urnetwork
Exec=urnetwork %u
Terminal=false
Categories=Network;Security;
Keywords=VPN;URnetwork;proxy;privacy;
StartupNotify=true
StartupWMClass=network.ur.urnetwork
# Register the urnetwork:// scheme so OAuth/SSO callbacks (and wallet deep links)
# route back to a running instance. The snap `desktop` extension exports this
# handler to the host via xdg-mime.
MimeType=x-scheme-handler/urnetwork;
