#!/bin/sh
# AppRun for the URnetwork GUI AppImage (hand-rolled AppDir; APPIMAGE.md 11e).
#
# Sets exactly the environment the bundled GTK4/libadwaita stack needs and
# NOTHING that second-guesses the host session:
#   - no GTK_THEME  (it overrides libadwaita's own theming -- the
#     linuxdeploy-plugin-gtk bug that makes apps render wrong)
#   - no GDK_BACKEND (pinning x11 puts every Wayland user on XWayland)
#   - no GSK_RENDERER (auto-detect; `GSK_RENDERER=cairo urnetwork` is the
#     user-side fallback on broken GL stacks)

HERE="$(dirname "$(readlink -f "$0")")"
APPDIR="${APPDIR:-$HERE}"
export APPDIR

# Bundled libraries first; the SDK library lives beside the daemon-layout
# path usr/lib/urnetwork (MIGRATION.md table).
LD_LIBRARY_PATH="$APPDIR/usr/lib:$APPDIR/usr/lib/urnetwork${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
export LD_LIBRARY_PATH

# Bundled schemas, icon themes, app data (world-110m.json resolves via
# $APPDIR + UR_PKGDATADIR in the app) -- prepend, keep the host's dirs.
XDG_DATA_DIRS="$APPDIR/usr/share:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
export XDG_DATA_DIRS

# A missing GSettings schema is a hard abort in GTK4; point at the compiled
# bundle (GSETTINGS_SCHEMA_DIR is additive to XDG_DATA_DIRS lookups).
if [ -d "$APPDIR/usr/share/glib-2.0/schemas" ]; then
    GSETTINGS_SCHEMA_DIR="$APPDIR/usr/share/glib-2.0/schemas"
    export GSETTINGS_SCHEMA_DIR
fi

# GIO modules (glib-networking TLS): the GLib family is bundled WITH its GIO
# modules -- never split (APPIMAGE.md section 4 invariant).
if [ -d "$APPDIR/usr/lib/gio/modules" ]; then
    GIO_MODULE_DIR="$APPDIR/usr/lib/gio/modules"
    export GIO_MODULE_DIR
fi

# gdk-pixbuf loaders: the cache format stores ABSOLUTE loader paths and the
# squashfs mount point changes every run, so regenerate the cache at launch
# with the bundled gdk-pixbuf-query-loaders (milliseconds). If anything
# fails, fall back to the host's loaders by leaving the env unset.
pixbuf_moduledir=""
for d in "$APPDIR"/usr/lib/gdk-pixbuf-2.0/*/loaders; do
    [ -d "$d" ] && pixbuf_moduledir="$d"
done
if [ -n "$pixbuf_moduledir" ] && [ -x "$APPDIR/usr/bin/gdk-pixbuf-query-loaders" ]; then
    cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}/urnetwork"
    if mkdir -p "$cache_dir" 2>/dev/null; then
        cache="$cache_dir/gdk-pixbuf-loaders.cache"
        if GDK_PIXBUF_MODULEDIR="$pixbuf_moduledir" \
            "$APPDIR/usr/bin/gdk-pixbuf-query-loaders" > "$cache" 2>/dev/null \
            && [ -s "$cache" ]; then
            GDK_PIXBUF_MODULE_FILE="$cache"
            export GDK_PIXBUF_MODULE_FILE
        fi
    fi
fi

exec "$APPDIR/usr/bin/urnetwork-gui" "$@"
