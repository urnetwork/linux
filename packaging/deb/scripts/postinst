#!/bin/sh
# postinst for urnetwork-daemon.
#
# nfpm does not generate maintainer scripts, so this is written to match what
# dh_installsystemd (debhelper compat 13) generates for
#     dh_installsystemd --no-restart-after-upgrade urnetworkd.service
# with the semantics that matter preserved exactly:
#   - enable-once via deb-systemd-helper: `was-enabled` consults d-s-h's own
#     state file, so an admin's deliberate `systemctl disable` survives every
#     later upgrade instead of being undone behind their back.
#   - service starts go through deb-systemd-invoke, which respects
#     /usr/sbin/policy-rc.d (chroots, containers and image builds can veto).
#   - every systemd interaction is guarded on [ -d /run/systemd/system ].
#   - stop-then-START across upgrades: prerm stopped the old binary, we plain
#     `start` the new one here. Never restart-after-upgrade for a daemon
#     holding a live tun fd.
# Enabling AND starting on install is correct under Debian Policy 9.3.3.1
# only because urnetworkd STARTS IDLE -- it never brings up a tunnel until an
# authenticated client asks over the control socket.
#
# Deliberately absent: anything touching /usr/share/applications or
# /usr/share/icons. Those ship as plain dpkg files precisely so the
# desktop-file-utils / hicolor-icon-theme dpkg file triggers refresh
# mimeinfo.cache and the icon cache; creating them here would silently skip
# the triggers (APPIMAGE.md 11d).
set -e

UNIT='urnetworkd.service'

case "$1" in
    configure)
        # The `urnetwork` system group: STILL CREATED, AND NOBODY IS PUT IN IT.
        #
        # It is now only the FALLBACK authorizer, for machines with no polkit:
        # there urnetworkd binds the socket 0660 root:urnetwork and authorizes
        # uid 0 plus members of this group, exactly as before. Where polkit is
        # present, membership is inert -- the socket is 0666 root:root and every
        # privileged verb is authorized per-action by polkit against the peer's
        # SO_PEERCRED uid, in the session the user is already in.
        #
        # Created before the unit starts; removed only on purge. Existing
        # members are never removed: the gid owns /run/urnetwork on a group-mode
        # box and a downgrade to an older daemon has to keep working.
        #
        # WHAT IS GONE, DELIBERATELY: `usermod -aG urnetwork "$SUDO_USER"` and
        # the "log out and back in" line that had to follow it. Supplementary
        # groups are applied at LOGIN, so that pair made a correct install
        # unusable until the user ended their session. That is the first-run
        # experience this change exists to remove.
        if ! getent group urnetwork >/dev/null 2>&1; then
            if command -v addgroup >/dev/null 2>&1; then
                addgroup --system urnetwork >/dev/null 2>&1 || groupadd --system urnetwork
            else
                groupadd --system urnetwork
            fi
        fi
        # Which authority this machine will run under, said out loud.
        #
        # DETECTED BY LOOKING FOR POLKIT, NOT FOR OUR OWN ACTION FILE: dpkg has
        # already unpacked /usr/share/polkit-1/actions/com.bringyour.network
        # .policy by the time this runs (and created that directory on the way),
        # so testing the file or the directory would report "polkit" on a box
        # that has never had it. polkitd is a Recommends, so apt pulls it in by
        # default and this branch is the normal one.
        UR_HAS_POLKIT=0
        if command -v pkaction >/dev/null 2>&1 || command -v pkcheck >/dev/null 2>&1; then
            UR_HAS_POLKIT=1
        elif [ -f /usr/share/polkit-1/actions/org.freedesktop.policykit.policy ]; then
            UR_HAS_POLKIT=1
        else
            for d in /usr/lib/polkit-1 /usr/libexec/polkit-1 /usr/lib64/polkit-1 \
                     /usr/lib/x86_64-linux-gnu/polkit-1 /usr/lib/aarch64-linux-gnu/polkit-1; do
                if [ -x "${d}/polkitd" ]; then UR_HAS_POLKIT=1; break; fi
            done
        fi
        if [ "${UR_HAS_POLKIT}" = 1 ]; then
            echo "urnetwork: permission is granted through polkit -- no group change and no log-out are needed."
            if [ -n "$(getent group urnetwork 2>/dev/null | cut -d: -f4)" ]; then
                echo "urnetwork: the 'urnetwork' group still has members from an earlier version. Nothing to undo -- membership is simply no longer consulted where polkit is present."
            fi
        else
            echo "urnetwork: no polkit found; urnetworkd falls back to the 'urnetwork' group."
            echo "urnetwork: run 'sudo usermod -aG urnetwork <user>', then log out and back in. Installing polkitd and reinstalling this package removes that requirement."
        fi
        # polkit IGNORES a group- or world-writable .policy file, silently: the
        # actions revert to their built-in defaults and the only symptom is an
        # administrator prompt on every Connect. dpkg ships ours 0644 root:root
        # from the package tree; assert it rather than assume it, and check the
        # directory too (polkit does not police the directory, and whoever can
        # write it can drop in a file that redefines our defaults).
        UR_POLICY=/usr/share/polkit-1/actions/com.bringyour.network.policy
        if [ -f "${UR_POLICY}" ]; then
            chmod 0644 "${UR_POLICY}" 2>/dev/null || true
            chown root:root "${UR_POLICY}" 2>/dev/null || true
            UR_POLICY_DIR_MODE="$(stat -c '%a' /usr/share/polkit-1/actions 2>/dev/null || echo '')"
            case "${UR_POLICY_DIR_MODE}" in
                '') : ;;
                *[2367]|*[2367]?)
                    echo "urnetwork: WARNING /usr/share/polkit-1/actions is group- or world-writable (mode ${UR_POLICY_DIR_MODE}); anyone who can write there can redefine URnetwork's polkit defaults." >&2 ;;
            esac
        fi
        # /run/urnetwork is really owned by the unit's RuntimeDirectory=
        # (0755 root:root, re-applied on every start); pre-create it so the
        # control path exists even before the first start. The daemon narrows
        # it to 0750 root:urnetwork itself when it finds no polkit action file.
        if [ -d /run ]; then
            if [ "${UR_HAS_POLKIT}" = 1 ]; then
                install -d -m 0755 -o root -g root /run/urnetwork 2>/dev/null || true
            else
                install -d -m 0750 -o root -g urnetwork /run/urnetwork 2>/dev/null || true
            fi
        fi
        # The NetworkManager conf.d marking must be live before the first
        # tunnel comes up; `nmcli general reload conf` re-reads configuration
        # without touching connections. Same for the udev rule.
        if command -v nmcli >/dev/null 2>&1; then
            nmcli general reload conf >/dev/null 2>&1 || true
        fi
        if command -v udevadm >/dev/null 2>&1; then
            udevadm control --reload >/dev/null 2>&1 || true
        fi
        ;;
esac

# --- dh_installsystemd-equivalent: enable (once) -----------------------------
if [ "$1" = "configure" ] || [ "$1" = "abort-upgrade" ] || [ "$1" = "abort-deconfigure" ] || [ "$1" = "abort-remove" ]; then
    if command -v deb-systemd-helper >/dev/null 2>&1; then
        # Removes only masks created by d-s-h on a previous package removal.
        deb-systemd-helper unmask "$UNIT" >/dev/null || true
        # was-enabled defaults to true, so the first installation enables the
        # unit; a recorded admin disable is respected on every upgrade.
        if deb-systemd-helper --quiet was-enabled "$UNIT"; then
            deb-systemd-helper enable "$UNIT" >/dev/null || true
        else
            deb-systemd-helper update-state "$UNIT" >/dev/null || true
        fi
    elif [ -d /run/systemd/system ]; then
        # Fallback for dpkg systems without init-system-helpers (rare):
        # enable only on first configure, never on upgrade.
        if [ -z "${2:-}" ]; then
            systemctl enable "$UNIT" >/dev/null || true
        fi
    fi
fi

# --- dh_installsystemd-equivalent: start (stop happened in prerm) ------------
if [ "$1" = "configure" ] || [ "$1" = "abort-upgrade" ] || [ "$1" = "abort-deconfigure" ] || [ "$1" = "abort-remove" ]; then
    if [ -d /run/systemd/system ]; then
        systemctl --system daemon-reload >/dev/null || true
        if command -v deb-systemd-invoke >/dev/null 2>&1; then
            deb-systemd-invoke start "$UNIT" >/dev/null || true
        else
            systemctl start "$UNIT" >/dev/null || true
        fi
    fi
fi

exit 0
